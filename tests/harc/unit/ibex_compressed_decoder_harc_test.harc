domain DecoderDomain
    freq_mhz: 100
end domain DecoderDomain

testbench DecoderTb
    dut : ibex_compressed_decoder
    drv : DecoderDriver active
    mon : DecoderMonitor passive
    sb : DecoderScoreboard
    scenarios : DecoderScenarios
    protocol_cov : DecoderProtocol
    stack_cov : DecoderStack

    function replay()
        drv.dut = dut
        mon.dut = dut
        let count = cd_count()
        assert count > 0 else fail("empty corpus")
        let t : DecoderCycle
        for row in 0 .. count - 1
            t.row = row
            t.rst_n = cd_field(row, 0) != 0
            t.valid = cd_field(row, 1) != 0
            t.ready = cd_field(row, 2) != 0
            t.instr = cd_field(row, 3)
            t.expected = cd_field(row, 4)
            t.compressed = cd_field(row, 5) != 0
            t.illegal = cd_field(row, 6) != 0
            t.expanded = cd_field(row, 7).trunc<2>()
            t.phase = cd_field(row, 8).trunc<2>()
            t.rlist_group = 7
            t.spimm = 7
            let family = t.instr & 0xff03
            if family == 0xb802 || family == 0xba02 || family == 0xbc02 || family == 0xbe02
                let rlist = (t.instr >> 4) & 15
                t.rlist_group = 2
                if rlist < 4
                    t.rlist_group = 0
                elsif rlist == 4
                    t.rlist_group = 1
                elsif rlist == 15
                    t.rlist_group = 3
                end if
                t.spimm = ((t.instr >> 2) & 3).trunc<3>()
            end if
            drv.drive(t)
            mon.observe()
            sb.compare(t, mon.instr, mon.compressed, mon.illegal, mon.expanded)
            if t.rst_n && sb.passed
                t.cp_32_bit_pass_through = cp_32_bit_pass_through_select(t)
                t.cp_zca_quadrant_0_c_addi4spn = cp_zca_quadrant_0_c_addi4spn_select(t)
                t.cp_zca_quadrant_0_c_lw = cp_zca_quadrant_0_c_lw_select(t)
                t.cp_zca_quadrant_0_c_sw = cp_zca_quadrant_0_c_sw_select(t)
                t.cp_zcb_quadrant_0_c_lbu_c_lh_c_lhu_c_sb_c_sh = cp_zcb_quadrant_0_c_lbu_c_lh_c_lhu_c_sb_c_sh_select(t)
                t.cp_zca_quadrant_0_reserved_funct3_codes = cp_zca_quadrant_0_reserved_funct3_codes_select(t)
                t.cp_zca_quadrant_1_c_addi_c_nop = cp_zca_quadrant_1_c_addi_c_nop_select(t)
                t.cp_zca_quadrant_1_c_jal_c_j = cp_zca_quadrant_1_c_jal_c_j_select(t)
                t.cp_zca_quadrant_1_c_li = cp_zca_quadrant_1_c_li_select(t)
                t.cp_zca_quadrant_1_c_lui_c_addi16sp = cp_zca_quadrant_1_c_lui_c_addi16sp_select(t)
                t.cp_zca_quadrant_1_c_srli_c_srai = cp_zca_quadrant_1_c_srli_c_srai_select(t)
                t.cp_zca_quadrant_1_c_andi = cp_zca_quadrant_1_c_andi_select(t)
                t.cp_zca_quadrant_1_c_sub_c_xor_c_or_c_and = cp_zca_quadrant_1_c_sub_c_xor_c_or_c_and_select(t)
                t.cp_zcb_quadrant_1_c_mul = cp_zcb_quadrant_1_c_mul_select(t)
                t.cp_zcb_quadrant_1_zext_b_sext_b_zext_h_sext_h_not = cp_zcb_quadrant_1_zext_b_sext_b_zext_h_sext_h_not_select(t)
                t.cp_zca_quadrant_1_c_beqz_c_bnez = cp_zca_quadrant_1_c_beqz_c_bnez_select(t)
                t.cp_zca_quadrant_2_c_slli = cp_zca_quadrant_2_c_slli_select(t)
                t.cp_zca_quadrant_2_c_lwsp = cp_zca_quadrant_2_c_lwsp_select(t)
                t.cp_zca_quadrant_2_c_mv_c_jr_c_add_c_jalr_c_ebreak = cp_zca_quadrant_2_c_mv_c_jr_c_add_c_jalr_c_ebreak_select(t)
                t.cp_zca_quadrant_2_c_swsp = cp_zca_quadrant_2_c_swsp_select(t)
                t.cp_zca_quadrant_2_reserved_funct3_codes = cp_zca_quadrant_2_reserved_funct3_codes_select(t)
                t.cp_zcmp_cm_push_multi_cycle_expansion = cp_zcmp_cm_push_multi_cycle_expansion_select(t)
                t.cp_zcmp_cm_pop_cm_popret_cm_popretz_multi_cycle_expansion = cp_zcmp_cm_pop_cm_popret_cm_popretz_multi_cycle_expansion_select(t)
                t.cp_zcmp_cm_mvsa01_cm_mva01s = cp_zcmp_cm_mvsa01_cm_mva01s_select(t)
                t.cp_zcmp_default_reserved_encodings = cp_zcmp_default_reserved_encodings_select(t)
                t.cp_is_compressed_o_is_a_pure_lsb_decode = cp_is_compressed_o_is_a_pure_lsb_decode_select(t)
                t.cp_gets_expanded_o_gating_on_valid_i = cp_gets_expanded_o_gating_on_valid_i_select(t)
                t.cp_zcmp_fsm_stability_when_valid_i_0 = cp_zcmp_fsm_stability_when_valid_i_0_select(t)
                sb.accepted(t)
            end if
            t.previous_instr = t.instr
            t.previous_expected = t.expected
            t.previous_rst_n = t.rst_n
            assert cd_accept(row) == row + 1 else fail("corpus acceptance mismatch")
        end for
        assert cd_finish() == sb.checked else fail("corpus not fully checked")
    end function replay
end testbench DecoderTb

impl DecoderCoverage for DecoderTb
    clock clk_i = DecoderDomain
    run
        replay()
    end run
    check
        scenarios.report()
        protocol_cov.report()
        stack_cov.report()
        assert scenarios.cp_32_bit_pass_through.pass_through_addi > 0 else fail("missing cp_32_bit_pass_through.pass_through_addi")
        assert scenarios.cp_32_bit_pass_through.pass_through_ebreak > 0 else fail("missing cp_32_bit_pass_through.pass_through_ebreak")
        assert scenarios.cp_zca_quadrant_0_c_addi4spn.c_addi4spn_x8_sp_4 > 0 else fail("missing cp_zca_quadrant_0_c_addi4spn.c_addi4spn_x8_sp_4")
        assert scenarios.cp_zca_quadrant_0_c_addi4spn.c_addi4spn_reserved_zero_immediate > 0 else fail("missing cp_zca_quadrant_0_c_addi4spn.c_addi4spn_reserved_zero_immediate")
