// Parameter-contract source probe: the disabled-Zcmp output branch is not
// reachable in RV32ZC=3. This run is merged for source coverage only.
impl DecoderZcmpDisabled for DecoderTb
    clock clk_i = DecoderDomain
    run
        drv.dut = dut
        mon.dut = dut
        let t : DecoderCycle
        t.rst_n = false
        t.valid = false
        t.ready = false
        t.instr = 0
        drv.drive(t)
        t.rst_n = true
        t.valid = true
        t.instr = 0x00000001
        t.expected = 0x00000013
        t.compressed = true
        t.illegal = false
        t.expanded = 0
        drv.drive(t)
        mon.observe()
        sb.compare(t, mon.instr, mon.compressed, mon.illegal, mon.expanded)
    end run
    check
        assert sb.checked == 1 else fail("parameter probe did not check output")
    end check
end impl DecoderZcmpDisabled
