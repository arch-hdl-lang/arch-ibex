// Reference vectors come from pinned upstream SystemVerilog, never ARCH output.
extern function cd_count() -> uint<32>
extern function cd_field(row: uint<32>, col: uint<32>) -> uint<32>
extern function cd_accept(row: uint<32>) -> uint<32>
extern function cd_finish() -> uint<32>

transaction DecoderCycle
    previous_instr : uint<32> default 0
    previous_expected : uint<32> default 0
    previous_rst_n : bool default false
    cp_32_bit_pass_through : uint<8>
    cp_zca_quadrant_0_c_addi4spn : uint<8>
    cp_zca_quadrant_0_c_lw : uint<8>
    cp_zca_quadrant_0_c_sw : uint<8>
    cp_zcb_quadrant_0_c_lbu_c_lh_c_lhu_c_sb_c_sh : uint<8>
    cp_zca_quadrant_0_reserved_funct3_codes : uint<8>
    cp_zca_quadrant_1_c_addi_c_nop : uint<8>
    cp_zca_quadrant_1_c_jal_c_j : uint<8>
    cp_zca_quadrant_1_c_li : uint<8>
    cp_zca_quadrant_1_c_lui_c_addi16sp : uint<8>
    cp_zca_quadrant_1_c_srli_c_srai : uint<8>
    cp_zca_quadrant_1_c_andi : uint<8>
    cp_zca_quadrant_1_c_sub_c_xor_c_or_c_and : uint<8>
    cp_zcb_quadrant_1_c_mul : uint<8>
    cp_zcb_quadrant_1_zext_b_sext_b_zext_h_sext_h_not : uint<8>
    cp_zca_quadrant_1_c_beqz_c_bnez : uint<8>
    cp_zca_quadrant_2_c_slli : uint<8>
    cp_zca_quadrant_2_c_lwsp : uint<8>
    cp_zca_quadrant_2_c_mv_c_jr_c_add_c_jalr_c_ebreak : uint<8>
    cp_zca_quadrant_2_c_swsp : uint<8>
    cp_zca_quadrant_2_reserved_funct3_codes : uint<8>
    cp_zcmp_cm_push_multi_cycle_expansion : uint<8>
    cp_zcmp_cm_pop_cm_popret_cm_popretz_multi_cycle_expansion : uint<8>
    cp_zcmp_cm_mvsa01_cm_mva01s : uint<8>
    cp_zcmp_default_reserved_encodings : uint<8>
    cp_is_compressed_o_is_a_pure_lsb_decode : uint<8>
    cp_gets_expanded_o_gating_on_valid_i : uint<8>
    cp_zcmp_fsm_stability_when_valid_i_0 : uint<8>
    row : uint<32>
    rst_n : bool
    valid : bool
    ready : bool
    instr : uint<32>
    expected : uint<32>
    compressed : bool
    illegal : bool
    expanded : uint<2>
    phase : uint<2>
    rlist_group : uint<3>
    spimm : uint<3>
end transaction DecoderCycle

transactor DecoderDriver
    dut : ibex_compressed_decoder
    when active
        hookable drive(t: DecoderCycle)
            dut.rst_ni = t.rst_n
            dut.valid_i = t.valid
            dut.id_in_ready_i = t.ready
            dut.instr_i = t.instr
            wait 1 cycle
        end drive
    end when
end transactor DecoderDriver

transactor DecoderMonitor
    dut : ibex_compressed_decoder
    instr : uint<32> default 0
    compressed : bool default false
    illegal : bool default false
    expanded : uint<2> default 0
    hookable observe()
        instr = dut.instr_o
        compressed = dut.is_compressed_o != 0
        illegal = dut.illegal_instr_o != 0
        expanded = dut.gets_expanded_o
    end observe
end transactor DecoderMonitor

scoreboard DecoderScoreboard
    passed : bool default false
    checked : uint<32> default 0
    hookable compare(t: DecoderCycle, instr: uint<32>, compressed: bool, illegal: bool, expanded: uint<2>)
        passed = (t.illegal || instr == t.expected) && compressed == t.compressed && illegal == t.illegal && expanded == t.expanded
        assert t.illegal || instr == t.expected
            else fail("row ${t.row}, input 0x${t.instr:08x}: got 0x${instr:08x}, expected 0x${t.expected:08x}")
        assert compressed == t.compressed && illegal == t.illegal && expanded == t.expanded
            else fail("row ${t.row}, input 0x${t.instr:08x}: flags got ${compressed}/${illegal}/${expanded}, expected ${t.compressed}/${t.illegal}/${t.expanded}")
        checked = checked + 1
    end compare
    // Called only after comparison, and only outside reset.
    hookable accepted(t: DecoderCycle)
    end accepted
end scoreboard DecoderScoreboard

// Named scenario predicates: coverage follows a successful independent comparison.
function cp_32_bit_pass_through_select(t: DecoderCycle) -> uint<8>
    if t.instr == 0x00100093 && t.valid == true
        return 0
    end if
    if t.instr == 0x00100073 && t.valid == true
        return 1
    end if
    return 255
end function cp_32_bit_pass_through_select

