function cp_zcmp_cm_push_multi_cycle_expansion_select(t: DecoderCycle) -> uint<8>
    if t.instr == 0x0000b842 && t.valid == true && t.expected == 0xfe112e23 && !t.illegal
        return 0
    end if
    if t.instr == 0x0000b842 && t.valid == true && t.expected == 0xff010113 && !t.illegal
        return 1
    end if
    if t.instr == 0x0000b822 && t.valid == true
        return 2
    end if
    return 255
end function cp_zcmp_cm_push_multi_cycle_expansion_select

function cp_zcmp_cm_pop_cm_popret_cm_popretz_multi_cycle_expansion_select(t: DecoderCycle) -> uint<8>
    if t.instr == 0x0000ba42 && t.valid == true && t.expected == 0x00c12083 && !t.illegal
        return 0
    end if
    if t.instr == 0x0000be42 && t.valid == true && t.expected == 0x00008067 && !t.illegal
        return 1
    end if
    if t.instr == 0x0000bc42 && t.valid == true && t.expected == 0x00000513 && !t.illegal
        return 2
    end if
    return 255
end function cp_zcmp_cm_pop_cm_popret_cm_popretz_multi_cycle_expansion_select

