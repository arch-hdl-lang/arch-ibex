//! IbexCore — top-level CPU module of the Ibex core.
//!
//! Replaces upstream `ibex_core.sv` (~2023 LoC; ~600 effective under
//! SoC pinning). Composes the four pipeline-stage sub-modules
//! (`IbexIfStage`, `IbexIdStage`, `IbexExBlock`, `IbexLoadStoreUnit`,
//! `IbexWbStage`) plus the upstream-SV `ibex_cs_registers` (kept
//! upstream per spec note N-2; instantiated via a hand-written
//! `ibex_cs_registers.archi` stub).
//!
//! The construct is `module ibex_core` (not `pipeline IbexCore`).
//! Per spec §N-19 the implementer is free to pick the construct;
//! per proposal Risks §3 plain `module` is the documented fallback.
//! Reasons:
//!   - the upstream is structurally a flat module — every cross-stage
//!     edge is combinational; the only state lives inside the sub-
//!     modules. A `pipeline` would inject framework `valid_r` flops
//!     that don't exist upstream.
//!   - the cross-stage rule for `pipeline` rejects backward refs
//!     skipping ≥1 stage; the EX→ID multdiv `imd_val_d_ex` feedback
//!     (spec R5) is exactly such a backward ref.
//!   - SV-instance inside a pipeline stage is unproven tooling
//!     (proposal Risks §3a); plain `module` makes it boring `inst`.
//!
//! SoC parameter pinning (spec §"Pinned parameter values"):
//!   RV32E=0, RV32M=RV32MFast(=2), RV32B=RV32BNone(=0),
//!   BranchTargetALU=0, WritebackStage=0, ICache=0,
//!   BranchPredictor=0, DbgTriggerEn=0, MemECC=0, DataIndTiming=0,
//!   DummyInstructions=0, PMPEnable=0, SecureIbex=0, ResetAll=0,
//!   RegFileECC=0.
//!
//! Spec: changes/port-ibex_core/specs/ibex_core/spec.md
//!   - 21 Requirements
//!   - 10 caller-side rules (CS-1..CS-10)
//!   - 13 producer-side rules (PS-1..PS-13)
//!   - 36 spec notes (N-1..N-36)
//! Per spec note N-2: ibex_cs_registers stays upstream-SV
//! (instantiated via `ibex_cs_registers.archi`).

use IbexCoreSharedPkg;

domain SysDomain
  freq_mhz: 100
end domain SysDomain

module ibex_core
  // ── Const params (snapped to SoC pin values) ─────────────────────────
  /// `RV32E`: 1-bit.  Pinned to 0 (full 32-entry RF).  See spec §pin.
  param RV32E[0:0]: const = 1'd0;
  /// `RV32M`: 2-bit `rv32m_e` enum.  Pinned to RV32MFast.
  param RV32M: ibex_pkg::rv32m_e = ibex_pkg::RV32MFast;
  /// `RV32B`: 2-bit `rv32b_e` enum.  Pinned to RV32BNone.
  param RV32B: ibex_pkg::rv32b_e = ibex_pkg::RV32BNone;
  /// `BranchTargetALU`: pinned 0 (no dedicated branch-target adder).
  param BranchTargetALU[0:0]: const = 1'd0;
  /// `WritebackStage`: pinned 0 (passthrough WB stage).
  param WritebackStage[0:0]: const = 1'd0;
  /// `ICache`: pinned 0 (icache disabled).
  param ICache[0:0]: const = 1'd0;
  /// `BranchPredictor`: pinned 0 (no BP).
  param BranchPredictor[0:0]: const = 1'd0;
  /// `DbgTriggerEn`: pinned 0 (no debug triggers).
  param DbgTriggerEn[0:0]: const = 1'd0;
  /// `MemECC`: pinned 0 (no memory ECC).
  param MemECC[0:0]: const = 1'd0;
  /// `DataIndTiming`: pinned 0 (no DIT).
  param DataIndTiming[0:0]: const = 1'd0;
  /// `DummyInstructions`: pinned 0 (no dummy instr LFSR).
  param DummyInstructions[0:0]: const = 1'd0;
  /// `PMPEnable`: pinned 0 (no PMP).
  param PMPEnable[0:0]: const = 1'd0;
  /// `SecureIbex`: pinned 0 (non-secure).
  param SecureIbex[0:0]: const = 1'd0;
  /// `ResetAll`: pinned 0 (default reset behavior).
  param ResetAll[0:0]: const = 1'd0;
  /// `RegFileECC`: pinned 0 (no RF ECC).
  param RegFileECC[0:0]: const = 1'd0;

  /// `RV32ZC`: enum forwarded to IF stage (pinned RV32ZcaZcbZcmp = 3).
  param RV32ZC: const = 3;

  /// `DmHaltAddr`: forwarded to IF stage.  Default upstream
  /// 32'h1A11_0800; the SoC overrides to 0.  We use the upstream
  /// default as the param pin — the SoC's instance binding overrides.
  param DmHaltAddr: const = 437323776;
  /// `DmExceptionAddr`: forwarded to IF stage.  Same shape as DmHaltAddr.
  param DmExceptionAddr: const = 437323784;

  /// MHPM counters: forwarded to CSRs.
  param MHPMCounterNum: const = 0;
  param MHPMCounterWidth: const = 40;

  /// Bus / I-cache widths: forwarded to IF stage.  Under MemECC=0
  /// MemDataWidth = 32; BUS_SIZE = 32.
  param BusSizeECC: const = 32;
  param TagSizeECC: const = 29;
  param LineSizeECC: const = 72;
  param MemDataWidth: const = 32;
  param IC_NUM_WAYS: const = 2;
  param IC_INDEX_W: const = 8;
  param ICacheECC[0:0]: const = 1'd0;
  param ICacheTweakInfection[0:0]: const = 1'd0;
  param PCIncrCheck[0:0]: const = 1'd0;

  /// LFSR seed/perm: forwarded to IF stage.
  param RndCnstLfsrSeed[31:0]: const = 32'd2891135988;
  param RndCnstLfsrPerm[159:0]: const = 160'd0;

  /// PMP defaults (forwarded to CSRs; sunk under PMPEnable=0).
  param PMPGranularity: const = 0;
  param PMPNumRegions: const = 4;
  param DbgHwBreakNum: const = 1;

  /// `RegFileDataWidth`: ibex_top localparam (= 32 under RegFileECC=0).
  /// Threaded as a parameter to ibex_core in ibex_top.sv:343.
  /// Pinned to 32; not consumed at this scope.
  param RegFileDataWidth: const = 32;

  /// Debug Module address window (forwarded to ID controller via
  /// IbexIdStage's `DmBaseAddr` / `DmAddrMask`-equivalent paths).
  /// Currently unused at IbexCore scope under our pinning; the
  /// controller's halt address comes from `DmHaltAddr`.
  param DmBaseAddr[31:0]: const = 32'h1A11_0000;
  param DmAddrMask[31:0]: const = 32'h0000_0FFF;

  /// PMP-reset structured parameters (`pmp_cfg_t [PMP_MAX_REGIONS]`,
  /// `[PMP_ADDR_MSB:0] [PMP_MAX_REGIONS]`, `pmp_mseccfg_t`) are
  /// passed by upstream `ibex_top.sv` unconditionally to its
  /// `ibex_core` instance.  Under PMPEnable=0 these are unused
  /// (spec R20).  arch-com cannot natively express SV
  /// `parameter ibex_pkg::pmp_cfg_t NAME[PMP_MAX_REGIONS]` typed
  /// parameters; declaring them as bare `const = 0` produces a
  /// parameter-binding type mismatch when ibex_top connects them
  /// (Verilator V3Width.cpp:2594 InitArray internal error).
  /// See `changes/port-ibex_core/spec-notes.md` for the open-question
  /// trade-off; the SoC-lint gate is documented there.
  /// PMP-reset structured params — declared natively as upstream
  /// `pmp_cfg_t [N]`, `[W:0] [N]`, and scalar `pmp_mseccfg_t` so
  /// `ibex_top` can pass typed values through and we can forward
  /// them on to `cs_registers_i`. Under PMPEnable=0 these are sunk.
  param PMPRstCfg:     ibex_pkg::pmp_cfg_t [16]   = ibex_pkg::PmpCfgRst;
  param PMPRstAddr:    UInt<34> [16]              = ibex_pkg::PmpAddrRst;
  param PMPRstMsecCfg: ibex_pkg::pmp_mseccfg_t    = ibex_pkg::PmpMseccfgRst;

  /// Misc CSR ID params (forwarded to CSRs).
  param CsrMvendorId[31:0]: const = 32'd0;
  param CsrMimpId[31:0]: const = 32'd0;

  // ── Clock + reset ────────────────────────────────────────────────────
  port clk_i:  in Clock<SysDomain>;
  port rst_ni: in Reset<Async, Low>;

  // ── Hart identity / boot ────────────────────────────────────────────
  port hart_id_i:    in UInt<32>;
  port boot_addr_i:  in UInt<32>;

  // ── Instruction memory interface (OBI) ──────────────────────────────
  port instr_req_o:    out Bool;
  port instr_gnt_i:    in  Bool;
  port instr_rvalid_i: in  Bool;
  port instr_addr_o:   out UInt<32>;
  port instr_rdata_i:  in  UInt<32>;
  port instr_err_i:    in  Bool;

  // ── Data memory interface (OBI) ─────────────────────────────────────
  port data_req_o:    out Bool;
  port data_gnt_i:    in  Bool;
  port data_rvalid_i: in  Bool;
  port data_we_o:     out Bool;
  port data_be_o:     out UInt<4>;
  port data_addr_o:   out UInt<32>;
  port data_wdata_o:  out UInt<32>;
  port data_rdata_i:  in  UInt<32>;
  port data_err_i:    in  Bool;

  // ── Register-file interface (RF lives outside in ibex_top) ──────────
  port dummy_instr_id_o: out Bool;
  port dummy_instr_wb_o: out Bool;
  port rf_raddr_a_o:     out UInt<5>;
  port rf_raddr_b_o:     out UInt<5>;
  port rf_waddr_wb_o:    out UInt<5>;
  port rf_we_wb_o:       out Bool;
  port rf_wdata_wb_ecc_o: out UInt<32>;
  port rf_rdata_a_ecc_i: in  UInt<32>;
  port rf_rdata_b_ecc_i: in  UInt<32>;

  // ── ICache RAM interface (off under ICache=0; ports still bind) ─────
  port ic_tag_req_o:        out UInt<IC_NUM_WAYS>;
  port ic_tag_write_o:      out Bool;
  port ic_tag_addr_o:       out UInt<IC_INDEX_W>;
  port ic_tag_wdata_o:      out UInt<TagSizeECC>;
  port ic_tag_rdata_i:      in  unpacked Vec<UInt<TagSizeECC>, IC_NUM_WAYS>;
  port ic_data_req_o:       out UInt<IC_NUM_WAYS>;
  port ic_data_write_o:     out Bool;
  port ic_data_addr_o:      out UInt<IC_INDEX_W>;
  port ic_data_wdata_o:     out UInt<LineSizeECC>;
  port ic_data_rdata_i:     in  unpacked Vec<UInt<LineSizeECC>, IC_NUM_WAYS>;
  port ic_scr_key_valid_i:  in  Bool;
  port ic_scr_key_req_o:    out Bool;

  // ── Interrupt inputs ────────────────────────────────────────────────
  port irq_software_i: in Bool;
  port irq_timer_i:    in Bool;
  port irq_external_i: in Bool;
  port irq_fast_i:     in UInt<15>;
  port irq_nm_i:       in Bool;
  port irq_pending_o:  out Bool;

  // ── Debug ───────────────────────────────────────────────────────────
  port debug_req_i:         in  Bool;
  /// `crash_dump_o`: 5-field crash dump record (current_pc, next_pc,
  /// last_data_addr, exception_pc, exception_addr).  Emitted as a
  /// flat 5×32-bit packed vector to stay compatible with upstream's
  /// `crash_dump_t` shape without introducing a new shared struct
  /// (per spec note N-14, the struct lives in `ibex_pkg`; we pack
  /// the same field order).
  port crash_dump_o:        out UInt<160>;
  port double_fault_seen_o: out Bool;

  // ── CPU control / alerts ────────────────────────────────────────────
  /// `fetch_enable_i`: 4-bit mubi.  Under SecureIbex=0 only bit 0
  /// is consumed (spec R10).
  port fetch_enable_i:        in  UInt<4>;
  port alert_minor_o:         out Bool;
  port alert_major_internal_o: out Bool;
  port alert_major_bus_o:     out Bool;
  /// `core_busy_o`: 4-bit mubi pattern (IbexMuBiOn=4'b0101 or
  /// IbexMuBiOff=4'b1010).  Per spec note N-34, the full mubi
  /// pattern is exported under non-secure.
  port core_busy_o:           out UInt<4>;

  // ── RVFI port stubs (out of scope per spec note N-1) ─────────────────
  /// Per spec N-1, the RVFI tracking pipeline is not implemented.
  /// However, upstream `ibex_top.sv` (kept upstream) instantiates
  /// `ibex_core` and connects RVFI output ports unconditionally
  /// when its `RVFI=true` core flag is set (the SoC lint target uses
  /// `ibex_top_tracing` which sets RVFI=true).  We expose the ports
  /// at the IbexCore boundary and tie every RVFI output to `0` so the
  /// SV binding succeeds without producing any tracking pipeline state.
  /// (See spec note N-1 last paragraph: "the only RVFI-related artifact
  /// that should be preserved is `unused_illegal_insn_id`".)
  port rvfi_valid:            out Bool;
  port rvfi_order:            out UInt<64>;
  port rvfi_insn:             out UInt<32>;
  port rvfi_trap:             out Bool;
  port rvfi_halt:             out Bool;
  port rvfi_intr:             out Bool;
  port rvfi_mode:             out UInt<2>;
  port rvfi_ixl:              out UInt<2>;
  port rvfi_rs1_addr:         out UInt<5>;
  port rvfi_rs2_addr:         out UInt<5>;
  port rvfi_rs3_addr:         out UInt<5>;
  port rvfi_rs1_rdata:        out UInt<32>;
  port rvfi_rs2_rdata:        out UInt<32>;
  port rvfi_rs3_rdata:        out UInt<32>;
  port rvfi_rd_addr:          out UInt<5>;
  port rvfi_rd_wdata:         out UInt<32>;
  port rvfi_pc_rdata:         out UInt<32>;
  port rvfi_pc_wdata:         out UInt<32>;
  port rvfi_mem_addr:         out UInt<32>;
  port rvfi_mem_rmask:        out UInt<4>;
  port rvfi_mem_wmask:        out UInt<4>;
  port rvfi_mem_rdata:        out UInt<32>;
  port rvfi_mem_wdata:        out UInt<32>;
  port rvfi_ext_pre_mip:      out UInt<32>;
  port rvfi_ext_post_mip:     out UInt<32>;
  port rvfi_ext_nmi:          out Bool;
  port rvfi_ext_nmi_int:      out Bool;
  port rvfi_ext_debug_req:    out Bool;
  port rvfi_ext_debug_mode:   out Bool;
  port rvfi_ext_rf_wr_suppress: out Bool;
  port rvfi_ext_mcycle:       out UInt<64>;
  port rvfi_ext_mhpmcounters:    out unpacked Vec<UInt<32>, 10>;
  port rvfi_ext_mhpmcountersh:   out unpacked Vec<UInt<32>, 10>;
  port rvfi_ext_ic_scr_key_valid: out Bool;
  port rvfi_ext_irq_valid:    out Bool;
  port rvfi_ext_expanded_insn_valid: out Bool;
  port rvfi_ext_expanded_insn:    out UInt<16>;
  port rvfi_ext_expanded_insn_last: out Bool;

  // ── Constants (let bindings) ────────────────────────────────────────
  /// Multi-bit mubi encoding (spec note N-7).
  /// `IbexMuBiOn = 4'b0101` (= 5), `IbexMuBiOff = 4'b1010` (= 10).
  let IBEX_MU_BI_ON:  UInt<4> = 4'd5;
  let IBEX_MU_BI_OFF: UInt<4> = 4'd10;

  /// `wb_instr_type_e::WB_INSTR_OTHER` = 2 (spec R15 binding).
  let WB_INSTR_OTHER: UInt<2> = 2'd2;

  // ── Internal wires: IF→ID register pair ──────────────────────────────
  /// `instr_valid_id`, `instr_rdata_id`, `instr_rdata_alu_id`,
  /// `instr_rdata_c_id`, `instr_is_compressed_id`, etc.
  /// Spec R3 (IF→ID handshake).
  wire instr_valid_id:        Bool;
  wire instr_new_id:          Bool;
  wire instr_rdata_id:        UInt<32>;
  wire instr_rdata_alu_id:    UInt<32>;
  wire instr_rdata_c_id:      UInt<16>;
  wire instr_is_compressed_id: Bool;
  wire instr_gets_expanded_id: UInt<2>;
  wire instr_expanded_id:     UInt<16>;
  wire instr_bp_taken_id:     Bool;
  wire instr_fetch_err:       Bool;
  wire instr_fetch_err_plus2: Bool;
  wire illegal_c_insn_id:     Bool;
  wire dummy_instr_id:        Bool;
  wire pc_if:                 UInt<32>;
  wire pc_id:                 UInt<32>;
  wire instr_intg_err:        Bool;

  // ── ID→IF redirect wires ─────────────────────────────────────────────
  wire instr_valid_clear:     Bool;
  wire pc_set:                Bool;
  wire pc_mux_id:             UInt<3>;
  wire nt_branch_mispredict:  Bool;
  wire nt_branch_addr:        UInt<32>;
  wire exc_pc_mux_id:         UInt<2>;
  wire exc_cause:             ExcCause;
  wire icache_inval:          Bool;
  wire instr_req_int:         Bool;
  wire instr_first_cycle_id:  Bool;
  wire id_in_ready:           Bool;
  wire pc_mismatch_alert:     Bool;
  wire if_busy:               Bool;

  // ── ID→EX dispatch wires ─────────────────────────────────────────────
  wire alu_operator_ex:       UInt<7>;
  wire alu_operand_a_ex:      UInt<32>;
  wire alu_operand_b_ex:      UInt<32>;
  wire bt_a_operand:          UInt<32>;
  wire bt_b_operand:          UInt<32>;
  wire mult_en_ex:            Bool;
  wire div_en_ex:             Bool;
  wire mult_sel_ex:           Bool;
  wire div_sel_ex:            Bool;
  wire multdiv_operator_ex:   UInt<2>;
  wire multdiv_signed_mode_ex: UInt<2>;
  wire multdiv_operand_a_ex:  UInt<32>;
  wire multdiv_operand_b_ex:  UInt<32>;
  wire multdiv_ready_id:      Bool;

  // ── EX↔ID multdiv intermediate-value feedback (spec R5) ──────────────
  /// Per N-3/N-4: `imd_val_q_ex` flop lives in `id_stage_i`.
  /// EX combinationally drives `imd_val_d_ex` + `imd_val_we_ex`;
  /// ID flops them into `imd_val_q_ex` next cycle and re-presents.
  /// Both .arch sub-modules declare these as `unpacked Vec`.
  wire imd_val_we_ex:         UInt<2>;
  wire imd_val_d_ex:          unpacked Vec<UInt<34>, 2>;
  wire imd_val_q_ex:          unpacked Vec<UInt<34>, 2>;

  // ── EX→ID/IF/LSU result wires ────────────────────────────────────────
  wire alu_adder_result_ex:   UInt<32>;
  wire result_ex:             UInt<32>;
  wire branch_target_ex:      UInt<32>;
  wire branch_decision:       Bool;
  wire ex_valid:              Bool;

  // ── LSU req/resp wires ───────────────────────────────────────────────
  wire data_req_out:          Bool;
  wire lsu_we:                Bool;
  wire lsu_type:              UInt<2>;
  wire lsu_wdata:             UInt<32>;
  wire lsu_sign_ext:          Bool;
  wire rf_wdata_lsu:          UInt<32>;
  wire lsu_rdata_valid:       Bool;
  wire lsu_req:               Bool;
  wire lsu_req_done:          Bool;
  wire lsu_addr_incr_req:     Bool;
  wire lsu_addr_last:         UInt<32>;
  wire lsu_resp_valid:        Bool;
  wire lsu_load_err_raw:      Bool;
  wire lsu_load_resp_intg_err: Bool;
  wire lsu_store_err_raw:     Bool;
  wire lsu_store_resp_intg_err: Bool;
  wire lsu_busy:              Bool;
  wire perf_load:             Bool;
  wire perf_store:            Bool;

  // ── Non-secure LSU error / RF-write aliases (spec R21) ───────────────
  wire lsu_load_err:          Bool;
  wire lsu_store_err:         Bool;
  wire lsu_resp_err:          Bool;
  wire rf_we_lsu:             Bool;

  // ── ID outputs ───────────────────────────────────────────────────────
  wire ctrl_busy:             Bool;
  wire illegal_insn_id:       Bool;
  wire instr_id_done:         Bool;
  wire perf_jump:             Bool;
  wire perf_branch:           Bool;
  wire perf_tbranch:          Bool;
  wire perf_dside_wait:       Bool;
  wire perf_mul_wait:         Bool;
  wire perf_div_wait:         Bool;
  wire perf_iside_wait:       Bool;

  // ── ID→CSR access dispatch ───────────────────────────────────────────
  wire csr_access:            Bool;
  wire csr_op:                UInt<2>;
  wire csr_addr:              UInt<12>;
  wire csr_op_en:             Bool;
  wire csr_save_if:           Bool;
  wire csr_save_id:           Bool;
  wire csr_save_wb:           Bool;
  wire csr_restore_mret_id:   Bool;
  wire csr_restore_dret_id:   Bool;
  wire csr_save_cause:        Bool;
  wire csr_mtval:             UInt<32>;
  wire csr_wdata:             UInt<32>;

  // ── CSR→ID outputs ───────────────────────────────────────────────────
  wire priv_mode_id:          UInt<2>;
  wire priv_mode_lsu:         UInt<2>;
  wire csr_mstatus_tw:        Bool;
  wire illegal_csr_insn_id:   Bool;
  wire csr_rdata:             UInt<32>;
  wire csr_mstatus_mie:       Bool;
  wire irq_pending_int:       Bool;
  wire irqs_int:              Irqs;
  wire nmi_mode:              Bool;
  wire csr_mepc:              UInt<32>;
  wire crash_dump_mtval:      UInt<32>;
  wire csr_depc:              UInt<32>;
  wire csr_mtvec:             UInt<32>;
  wire csr_mtvec_init:        Bool;
  wire data_ind_timing:       Bool;
  wire dummy_instr_en:        Bool;
  wire dummy_instr_mask:      UInt<3>;
  wire dummy_instr_seed_en:   Bool;
  wire dummy_instr_seed:      UInt<32>;
  wire icache_enable:         Bool;
  wire icache_ecc_error:      Bool;
  wire csr_shadow_err:        Bool;

  // ── Debug-mode signals ───────────────────────────────────────────────
  wire debug_mode:            Bool;
  wire debug_mode_entering:   Bool;
  wire debug_cause:           UInt<3>;
  wire debug_csr_save:        Bool;
  wire debug_single_step:     Bool;
  wire debug_ebreakm:         Bool;
  wire debug_ebreaku:         Bool;
  wire trigger_match:         Bool;

  // ── PMP CSR outputs (sunk under PMPEnable=0) ─────────────────────────
  wire csr_pmp_cfg:           unpacked Vec<UInt<6>, 4>;
  wire csr_pmp_addr:          unpacked Vec<UInt<34>, 4>;
  wire csr_pmp_mseccfg:       UInt<3>;

  // ── PMP request errors (spec R20: tied 0 under PMPEnable=0) ──────────
  /// `pmp_req_err[2]` indexed: 0=PMP_I, 1=PMP_I2, 2=PMP_D.
  wire pmp_req_err:           UInt<3>;

  // ── RF read / write internal wires ───────────────────────────────────
  wire rf_raddr_a:            UInt<5>;
  wire rf_raddr_b:            UInt<5>;
  wire rf_waddr_id:           UInt<5>;
  wire rf_wdata_id:           UInt<32>;
  wire rf_we_id:              Bool;
  wire rf_ren_a:              Bool;
  wire rf_ren_b:              Bool;
  wire rf_rd_a_wb_match:      Bool;
  wire rf_rd_b_wb_match:      Bool;
  wire rf_rdata_a:            UInt<32>;
  wire rf_rdata_b:            UInt<32>;
  wire rf_waddr_wb:           UInt<5>;
  wire rf_wdata_wb:           UInt<32>;
  wire rf_we_wb:              Bool;
  wire rf_wdata_fwd_wb:       UInt<32>;
  wire rf_write_wb:           Bool;
  wire rf_ecc_err_comb:       Bool;

  // ── WB-stage signals ─────────────────────────────────────────────────
  wire ready_wb:              Bool;
  wire en_wb:                 Bool;
  wire instr_perf_count_id:   Bool;
  wire outstanding_load_wb:   Bool;
  wire outstanding_store_wb:  Bool;
  wire pc_wb:                 UInt<32>;
  wire perf_instr_ret_wb:                 Bool;
  wire perf_instr_ret_compressed_wb:      Bool;
  wire perf_instr_ret_wb_spec:            Bool;
  wire perf_instr_ret_compressed_wb_spec: Bool;
  wire dummy_instr_wb:        Bool;
  wire instr_done_wb:         Bool;
  wire expecting_load_resp_id: Bool;
  wire expecting_store_resp_id: Bool;

  // ── Lint-sink wires (per spec note N-23) ─────────────────────────────
  /// `unused_fetch_enable = ^fetch_enable_i[3:1]` absorbs bits[3:1].
  wire unused_fetch_enable:   Bool;
  /// `unused_illegal_insn_id = illegal_insn_id` (RVFI sink under N-1).
  wire unused_illegal_insn_id: Bool;

  // ── Sub-module: IF stage (spec R3) ───────────────────────────────────
