  // ── Module-scope combinational glue ──────────────────────────────────
  comb
    // ── Core-busy reduction (spec R9, N-7, N-34) ──────────────────────
    /// Per spec R9: under SecureIbex=0, `core_busy_o` is the full
    /// 4-bit mubi pattern.  IbexMuBiOn when any of ctrl_busy / if_busy
    /// / lsu_busy is high, IbexMuBiOff otherwise.
    core_busy_o = (ctrl_busy or if_busy or lsu_busy) ? IBEX_MU_BI_ON : IBEX_MU_BI_OFF;

    // ── Fetch-enable gating (spec R10) ────────────────────────────────
    /// Per spec R10: `unused_fetch_enable = ^fetch_enable_i[3:1]`
    /// absorbs unused bits.
    unused_fetch_enable = (fetch_enable_i[3] ^ fetch_enable_i[2]) ^ fetch_enable_i[1];

    // ── iside-wait perf pulse (spec R19, line 528) ────────────────────
    /// `perf_iside_wait = id_in_ready & ~instr_valid_id`.
    perf_iside_wait = id_in_ready and not instr_valid_id;

    // ── LSU PMP-mask collapse (spec R8, R20) ──────────────────────────
    /// Per spec §LSU PMP-mask collapse: under PMPEnable=0,
    /// `data_req_o = data_req_out` (the gate `~pmp_req_err[2]`
    /// folds to 1).
    data_req_o = data_req_out and not pmp_req_err[2];

    // ── LSU error reduction (spec R8) ─────────────────────────────────
    lsu_resp_err = lsu_load_err or lsu_store_err;

    // ── Non-secure LSU error / RF-write aliases (spec R21) ────────────
    /// Per spec R21: non-secure aliases.
    lsu_load_err  = lsu_load_err_raw;
    lsu_store_err = lsu_store_err_raw;
    rf_we_lsu     = lsu_rdata_valid;

    // ── PMP request errors (spec R20: tied 0 under PMPEnable=0) ───────
    /// Per spec R20: pmp_req_err[PMP_I/I2/D] = 0 under PMPEnable=0.
    pmp_req_err = 3'd0;

    // ── RF passthrough (spec R16) ─────────────────────────────────────
    /// Under RegFileECC=0: rf_rdata_*, rf_wdata_wb_ecc_o straight
    /// passthroughs; rf_ecc_err_comb = 0.
    rf_rdata_a       = rf_rdata_a_ecc_i;
    rf_rdata_b       = rf_rdata_b_ecc_i;
    rf_ecc_err_comb  = false;

    // ── CSR write-port aliasing (spec N-13, line 1053) ────────────────
    /// `csr_wdata = alu_operand_a_ex` continuous assignment.
    csr_wdata = alu_operand_a_ex;

    // ── Alert outputs (spec R18) ──────────────────────────────────────
    /// Per spec R18: alert_minor = icache_ecc_error.
    alert_minor_o          = icache_ecc_error;
    /// alert_major_internal = rf_ecc_err_comb | pc_mismatch_alert |
    /// csr_shadow_err.  Under RegFileECC=0/ShadowCSR=0 only
    /// pc_mismatch_alert can be non-zero (and PCIncrCheck=0 keeps
    /// that to 0 too).
    alert_major_internal_o = rf_ecc_err_comb or pc_mismatch_alert or csr_shadow_err;
    /// alert_major_bus = lsu_load_resp_intg_err | lsu_store_resp_intg_err
    /// | instr_intg_err.  All three are 0 under MemECC=0 (per
    /// spec note N-6).
    alert_major_bus_o      = lsu_load_resp_intg_err or lsu_store_resp_intg_err or instr_intg_err;

    // ── Crash-dump aggregation (spec R17, N-14) ───────────────────────
    /// Per spec R17 / line 961-965: 5-field crash_dump struct.
    /// Field order matches upstream `crash_dump_t`:
    /// {current_pc, next_pc, last_data_addr, exception_pc, exception_addr}.
    /// Emitted as a flat 5×32 packed UInt<160>.  Verilator accepts
    /// structurally compatible packed shapes across module boundaries.
    crash_dump_o = {pc_id, pc_if, lsu_addr_last, csr_mepc, crash_dump_mtval};

    // ── Top-level RF-port pass-through (spec line 898-903) ────────────
    /// Per spec §Top-level RF-port pass-through assigns.
    dummy_instr_id_o   = dummy_instr_id;
    dummy_instr_wb_o   = dummy_instr_wb;
    rf_raddr_a_o       = rf_raddr_a;
    rf_raddr_b_o       = rf_raddr_b;
    rf_waddr_wb_o      = rf_waddr_wb;
    rf_we_wb_o         = rf_we_wb;
    rf_wdata_wb_ecc_o  = rf_wdata_wb;

    // ── Top-level IRQ pending pass-through ────────────────────────────
    irq_pending_o = irq_pending_int;

    // ── RVFI sink (spec note N-1) ─────────────────────────────────────
    /// `unused_illegal_insn_id = illegal_insn_id` — the only RVFI
    /// remnant required as a lint sink under our pinning.
    unused_illegal_insn_id = illegal_insn_id;

    // ── RVFI port stubs tied to zero (spec note N-1) ──────────────────
    /// Per spec N-1, the RVFI tracking pipeline is out of scope.
    /// Drive every RVFI output to its all-zero reset value so upstream
    /// `ibex_top.sv` (which always binds these pins under the
    /// `ibex_top_tracing` core's RVFI=true flag) sees stable signals.
    rvfi_valid       = false;
    rvfi_order       = 64'd0;
    rvfi_insn        = 32'd0;
    rvfi_trap        = false;
    rvfi_halt        = false;
    rvfi_intr        = false;
    rvfi_mode        = 2'd0;
    rvfi_ixl         = 2'd0;
    rvfi_rs1_addr    = 5'd0;
    rvfi_rs2_addr    = 5'd0;
    rvfi_rs3_addr    = 5'd0;
    rvfi_rs1_rdata   = 32'd0;
    rvfi_rs2_rdata   = 32'd0;
    rvfi_rs3_rdata   = 32'd0;
    rvfi_rd_addr     = 5'd0;
    rvfi_rd_wdata    = 32'd0;
    rvfi_pc_rdata    = 32'd0;
    rvfi_pc_wdata    = 32'd0;
    rvfi_mem_addr    = 32'd0;
    rvfi_mem_rmask   = 4'd0;
    rvfi_mem_wmask   = 4'd0;
    rvfi_mem_rdata   = 32'd0;
    rvfi_mem_wdata   = 32'd0;
    rvfi_ext_pre_mip       = 32'd0;
    rvfi_ext_post_mip      = 32'd0;
    rvfi_ext_nmi           = false;
    rvfi_ext_nmi_int       = false;
    rvfi_ext_debug_req     = false;
    rvfi_ext_debug_mode    = false;
    rvfi_ext_rf_wr_suppress = false;
    rvfi_ext_mcycle        = 64'd0;
    rvfi_ext_ic_scr_key_valid = false;
    rvfi_ext_irq_valid        = false;
    rvfi_ext_expanded_insn_valid = false;
    rvfi_ext_expanded_insn       = 16'd0;
    rvfi_ext_expanded_insn_last  = false;
    rvfi_ext_mhpmcounters[0] = 32'd0;
    rvfi_ext_mhpmcounters[1] = 32'd0;
    rvfi_ext_mhpmcounters[2] = 32'd0;
    rvfi_ext_mhpmcounters[3] = 32'd0;
    rvfi_ext_mhpmcounters[4] = 32'd0;
    rvfi_ext_mhpmcounters[5] = 32'd0;
    rvfi_ext_mhpmcounters[6] = 32'd0;
    rvfi_ext_mhpmcounters[7] = 32'd0;
    rvfi_ext_mhpmcounters[8] = 32'd0;
    rvfi_ext_mhpmcounters[9] = 32'd0;
    rvfi_ext_mhpmcountersh[0] = 32'd0;
    rvfi_ext_mhpmcountersh[1] = 32'd0;
    rvfi_ext_mhpmcountersh[2] = 32'd0;
    rvfi_ext_mhpmcountersh[3] = 32'd0;
    rvfi_ext_mhpmcountersh[4] = 32'd0;
    rvfi_ext_mhpmcountersh[5] = 32'd0;
    rvfi_ext_mhpmcountersh[6] = 32'd0;
    rvfi_ext_mhpmcountersh[7] = 32'd0;
    rvfi_ext_mhpmcountersh[8] = 32'd0;
    rvfi_ext_mhpmcountersh[9] = 32'd0;
  end comb

  // ── Dummy let-bindings to absorb otherwise-unused signals ────────────
  // These signals exist purely as lint sinks per spec note N-23.
  // PMP CSR outputs (spec note N-11): consumed under PMPEnable=0=off.
  let _unused_priv_mode_lsu:    UInt<2>          = priv_mode_lsu;
  // Element-wise sinks for the unpacked-array PMP outputs (per
  // syntax pitfall: `unpacked` modifier isn't valid on `let` typed
  // bindings, only on `wire` declarations). One let per lane is
  // enough to satisfy the lint sink under PMPEnable=0.
  let _unused_csr_pmp_cfg_0:  UInt<6>  = csr_pmp_cfg[0];
  let _unused_csr_pmp_cfg_1:  UInt<6>  = csr_pmp_cfg[1];
  let _unused_csr_pmp_cfg_2:  UInt<6>  = csr_pmp_cfg[2];
  let _unused_csr_pmp_cfg_3:  UInt<6>  = csr_pmp_cfg[3];
  let _unused_csr_pmp_addr_0: UInt<34> = csr_pmp_addr[0];
  let _unused_csr_pmp_addr_1: UInt<34> = csr_pmp_addr[1];
  let _unused_csr_pmp_addr_2: UInt<34> = csr_pmp_addr[2];
  let _unused_csr_pmp_addr_3: UInt<34> = csr_pmp_addr[3];
  let _unused_csr_pmp_mseccfg:  UInt<3>          = csr_pmp_mseccfg;
  // RF-ECC sinks (spec R16 / line 942-949).
  let _unused_rf_ren_a:           Bool = rf_ren_a;
  let _unused_rf_ren_b:           Bool = rf_ren_b;
  let _unused_rf_rd_a_wb_match:   Bool = rf_rd_a_wb_match;
  let _unused_rf_rd_b_wb_match:   Bool = rf_rd_b_wb_match;
  // SecureIbex=0 mem-response probes (spec R21).
  let _unused_expecting_load_resp_id:  Bool = expecting_load_resp_id;
  let _unused_expecting_store_resp_id: Bool = expecting_store_resp_id;
  // RVFI-only producers (spec note N-24).
  let _unused_instr_new_id:           Bool      = instr_new_id;
  let _unused_instr_gets_expanded_id: UInt<2>   = instr_gets_expanded_id;
  let _unused_instr_expanded_id:      UInt<16>  = instr_expanded_id;
  let _unused_instr_done_wb:          Bool      = instr_done_wb;
  let _unused_instr_id_done:          Bool      = instr_id_done;
  // Dummy-instr LFSR (DummyInstructions=0) — driven by CSRs but
  // not consumed under our pinning.
  let _unused_dummy_instr_en:      Bool     = dummy_instr_en;
  let _unused_dummy_instr_mask:    UInt<3>  = dummy_instr_mask;
  let _unused_dummy_instr_seed_en: Bool     = dummy_instr_seed_en;
  let _unused_dummy_instr_seed:    UInt<32> = dummy_instr_seed;
  // ICache ECC error (ICache=0).
  let _unused_icache_ecc_error: Bool = icache_ecc_error;

end module ibex_core
