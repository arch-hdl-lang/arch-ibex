//! ibex_multdiv_fast — multi-cycle RV32M multiplier / divider (fast variant).
//!
//! Single-thread, dispatch-and-rejoin port. The thread waits at its head
//! `wait until mult_en_i or div_en_i`, then a top-level `if/elsif/else`
//! routes into one of four straight-line bodies (3-cycle MUL, 4-cycle
//! MULH, 2-cycle div-by-zero short-circuit, or 37-cycle long divide).
//! After the terminal `do … until multdiv_ready_id_i` of the chosen
//! branch, the default thread loop carries the FSM back to the head
//! wait.
//!
//! Mutual exclusion across the four sequences is now structural (one
//! thread can be in at most one branch at a time), so no `shared(or)`
//! merging or quiescent-zero coordination is needed — every output is a
//! single-driver. The IDLE-state ALU operand drive is held continuously
//! at the head wait via the comb assigns ahead of `wait until`, so the
//! `equal_to_zero_i` capture on the wait-exit edge sees the spec's
//! `0 - op_b_i` adder result (post arch-com PR #234, which fixed the
//! wait-exit comb-assign edge). The short-path predicate stays
//! `op_b_i == 0` (not `equal_to_zero_i`) to dodge the dead-skid race
//! where `wait 1 cycle` lowering momentarily drops the operand drive.
//!
//! refs:
//!   §"Requirement: Multiplier FSM walks ALBL → ALBH → AHBL for MUL (3 cycles)"
//!   §"Requirement: Multiplier FSM walks ALBL → ALBH → AHBL → AHBH for MULH/MULHSU/MULHU (4 cycles)"
//!   §"Requirement: 16×16 kernel multiplier with sign-extension to 17 b each side"
//!   §"Requirement: Result mux gates between divide and multiply paths via `div_sel_i`"
//!   §"Requirement: Divider FSM sequence for non-zero non-overflow operands (37 cycles)"
//!   §"Requirement: Divide-by-zero short-circuit (when `data_ind_timing_i = 0`)"
//!   §"Requirement: Constant-time mode forces full 37-cycle divide (`data_ind_timing_i = 1`)"
//!   §"Requirement: Signed overflow on `INT_MIN / -1` returns `INT_MIN` (DIV) or `0` (REM)"
//!   §"Requirement: ALU operand exchange (cross-module same-cycle contract)"
//!   §"Requirement: Intermediate-value lane assignment"
//!   §"Requirement: Reset behaviour"
//!   §"Requirement: `valid_o` is the OR of mult_valid and div_valid"

module ibex_multdiv_fast
  /// `RV32M` is integer-encoded `rv32m_e` from `ibex_pkg.sv`. This
  /// implementation always emits the multi-cycle (fast) kernel; the
  /// parameter is accepted for port-list compatibility (spec §"Port
  /// contract": `RV32M` ignored — the surrounding port-list pins it).
  param RV32M: const = 2;

  // ── Clock & async-low reset (§"Reset behaviour") ───────────────────
  port clk_i:  in Clock<SysDomain>;
  port rst_ni: in Reset<Async, Low>;

  // ── Decoder & enable inputs ────────────────────────────────────────
  port mult_en_i:  in Bool;
  port div_en_i:   in Bool;
  /// Structurally unused (spec §"Notes": kept on the port list for
  /// symmetry with the slow variant).
  port mult_sel_i: in Bool;
  /// Gates the lane-0 writeback mux and the result mux (spec §"Result
  /// mux gates between divide and multiply paths via `div_sel_i`",
  /// §"Intermediate-value lane assignment").
  port div_sel_i:  in Bool;

  /// `md_op_e` from `ibex_pkg`: 0=MULL, 1=MULH, 2=DIV, 3=REM.
  port operator_i:    in UInt<2>;
  /// Per-operand signedness: bit 0 → op_a, bit 1 → op_b.
  port signed_mode_i: in UInt<2>;
  port op_a_i:        in UInt<32>;
  port op_b_i:        in UInt<32>;

  // ── ALU shared paths (cross-module combinational loop) ─────────────
  /// Same-cycle reads (§"ALU operand exchange (cross-module same-cycle
  /// contract)"). The EX block presents the combinational sum back on
  /// `alu_adder_*_i` and the equality flag on `equal_to_zero_i`.
  port alu_adder_ext_i:   in UInt<34>;
  port alu_adder_i:       in UInt<32>;
  port equal_to_zero_i:   in Bool;
  port data_ind_timing_i: in Bool;

  // ── Outputs (single-driver: one thread, one branch active) ─────────
  port alu_operand_a_o: out UInt<33>;
  port alu_operand_b_o: out UInt<33>;

  /// Intermediate-value register-file ports — physically owned by the EX
  /// block. Lane 0 carries the partial product (mult) or partial
  /// remainder (div). Lane 1 carries the absolute-valued divisor (div
  /// only). Declared as packed Vec so the ex_block parent's internal
  /// wires (also packed) connect without a type mismatch.
  /// The ex_block boundary ports remain unpacked for SoC interop.
  port imd_val_q_i:  in Vec<UInt<34>, 2>;
  port imd_val_d_o:  out Vec<UInt<34>, 2>;
  port imd_val_we_o: out UInt<2>;

  port multdiv_ready_id_i: in Bool;
  port multdiv_result_o:   out UInt<32>;
  port valid_o:            out Bool;

  // ── Operator-encoding constants (§"Enum encodings") ─────────────────
  /// Kept as `let` (not `local param`) because this module uses `thread`,
  /// and arch-com's archsim emits thread bodies into a separate
  /// `_<mod>_threads.cpp` compilation unit that does not currently inherit
  /// parent-module params — `MD_OP_*` would resolve to undeclared
  /// identifiers in the threads helper. Revisit once arch-com propagates
  /// parent params into thread helpers.
  let MD_OP_MULL: UInt<2> = 2'd0;
  let MD_OP_MULH: UInt<2> = 2'd1;
  let MD_OP_DIV:  UInt<2> = 2'd2;
  let MD_OP_REM:  UInt<2> = 2'd3;

  // ── Internal divider registers ─────────────────────────────────────
  /// `op_numerator_q` and `op_quotient_q` are dedicated 32-b registers
  /// internal to the multdiv (NOT part of the EX-block intermediate-value
  /// file). `div_by_zero_q` latches the IDLE-cycle zero-divisor flag for
  /// `MD_CHANGE_SIGN` to suppress sign-flip on the long-path
  /// constant-time divide-by-zero (spec §"Constant-time mode forces full
  /// 37-cycle divide").
  reg op_numerator_q: UInt<32> reset rst_ni => 0;
  reg op_quotient_q:  UInt<32> reset rst_ni => 0;
  reg div_by_zero_q:  Bool     reset rst_ni => false;

  // ── Sign-mode helpers (§"Divider FSM …", §"Signed overflow …") ─────
  /// Whether the absolute-value pass should negate the operand.
  let div_sign_a: Bool = signed_mode_i[0] and op_a_i[31];
  let div_sign_b: Bool = signed_mode_i[1] and op_b_i[31];

  // ── Short-path predicate ───────────────────────────────────────────
  /// IDLE → FINISH shortcut fires on a divide with zero divisor in
  /// non-constant-time mode (spec §"Divide-by-zero short-circuit").
  /// Spec uses `equal_to_zero_i` (the ALU's `(adder == 0)` output)
  /// because upstream's IDLE-state ALU drives compute `0 - op_b` and
  /// equality detects op_b zero through the adder. We use
  /// `op_b_i == 0` directly here — equivalent condition, but doesn't
  /// depend on the ALU operand drives staying live across the thread
  /// compiler's dead-skid sub-state in `wait 1 cycle` lowering.
  let short_path: Bool = (op_b_i == 32'h0000_0000) and not data_ind_timing_i;

  // ── 16x16 mult kernel helper (§"16×16 kernel multiplier …") ────────
  /// `mac_res_signed = signed({sign_a, op_a16}) * signed({sign_b, op_b16})
  /// + signed(accum)`, then truncated to 34 b. The dropped bit `[34]` is
  /// documented as redundant in the spec — the 2 MSBs of the
  /// multiplicants and the 16 MSBs of `accum` always agree, so
  /// `mac_res_ext[34] == mac_res_ext[33]`.
  shared function MacRes(sign_a: Bool, op_a16: UInt<16>,
                  sign_b: Bool, op_b16: UInt<16>,
                  accum:  UInt<34>) -> UInt<34>
    let a17:    SInt<17> = signed({sign_a, op_a16});
    let b17:    SInt<17> = signed({sign_b, op_b16});
    let prod:   SInt<34> = a17 * b17;
    let acc_s:  SInt<34> = signed(accum);
    let sum35:  SInt<35> = prod + acc_s;
    return unsigned(sum35).trunc<34>();
  end function MacRes

  // ── Divider helper: is_greater_equal (spec §"Divider FSM …",
  //     `is_greater_equal` rule lines 392–401) ───────────────────────
  function IsGreaterEqual(part_rem_msb: Bool,
                          divisor_msb:  Bool,
                          res_adder_h_msb: Bool) -> Bool
    if part_rem_msb == divisor_msb
      return not res_adder_h_msb;
    else
      return part_rem_msb;
    end if
  end function IsGreaterEqual

  // ────────────────────────────────────────────────────────────────────
  // MultdivThread — single thread, dispatch-and-rejoin
  //
  // Head wait holds the IDLE-pattern ALU drives continuously; the
  // wait-exit edge captures `equal_to_zero_i` for the divide-by-zero
  // suppression flag. After the head wait, an if/elsif/else routes
  // into one of four straight-line bodies; each body's terminal
  // `do … until multdiv_ready_id_i` honours ID-stage back-pressure.
  // ────────────────────────────────────────────────────────────────────
  thread MultdivThread on clk_i rising, rst_ni low
    /// IDLE: drive the spec-prescribed `0 - op_b_i` ALU pattern so
    /// `equal_to_zero_i` is meaningful at the wait-exit edge.
    /// `div_by_zero_q ← equal_to_zero_i` is captured under the long-
    /// divide gate so MD_CHANGE_SIGN can later suppress the sign-flip
    /// on constant-time div-by-zero (spec line 437).
    alu_operand_a_o = {32'h0000_0000, 1'b1};
    alu_operand_b_o = {~op_b_i, 1'b1};
    if div_en_i and not short_path
      if operator_i == MD_OP_DIV
        imd_val_d_o[0] = 34'h3_FFFF_FFFF;
      else
        imd_val_d_o[0] = {2'b00, op_a_i};
      end if
      imd_val_we_o = 2'b01;
      div_by_zero_q <= equal_to_zero_i;
    elsif div_en_i and short_path and ((operator_i == MD_OP_DIV) or (operator_i == MD_OP_REM))
      /// Short-path seed: lane 0 captures the FINISH-state result
      /// (sentinel for DIV/DIVU, dividend pass-through for REM/REMU).
      if operator_i == MD_OP_DIV
        imd_val_d_o[0] = 34'h3_FFFF_FFFF;
      else
        imd_val_d_o[0] = {2'b00, op_a_i};
      end if
      imd_val_we_o = 2'b01;
    end if
    if mult_en_i and ((operator_i == MD_OP_MULL) or (operator_i == MD_OP_MULH))
      /// MUL/MULH first partial product (ALBL) is a wait-exit output:
      /// when ID presents a multiply request, EX latches this lane on the
      /// same edge that releases the head wait. The post-wait branch then
      /// continues at ALBH, matching the fast multdiv two/three-stall
      /// schedule without relying on the compiler to move observable comb
      /// work across the wait boundary.
      imd_val_d_o[0] = MacRes(false, op_a_i[15:0],
                              false, op_b_i[15:0],
                              34'h0_0000_0000);
      imd_val_we_o = 2'b01;
    end if
    wait until mult_en_i or div_en_i;

    if mult_en_i and (operator_i == MD_OP_MULL)
      // ── 3-cycle MUL walk (ALBL → ALBH → AHBL terminal) ──────────────
      /// Cycle 2 — ALBH: shift-and-concat trick for the low half of
      /// the running product. `mac_res_d = {2'b0, mac_res[15:0],
      /// imd_val_q_i[0][15:0]}`.
      imd_val_d_o[0] = {2'b00,
                        MacRes(false,                          op_a_i[15:0],
                               signed_mode_i[1] and op_b_i[31], op_b_i[31:16],
                               {18'b0, imd_val_q_i[0][31:16]})[15:0],
                        imd_val_q_i[0][15:0]};
      imd_val_we_o = 2'b01;
      wait 1 cycle;

      /// Cycle 3 — AHBL (terminal): expose the result and hold via
      /// `do … until multdiv_ready_id_i`.
      do
        imd_val_d_o[0] = {2'b00,
                          MacRes(signed_mode_i[0] and op_a_i[31], op_a_i[31:16],
                                 false,                          op_b_i[15:0],
                                 {18'b0, imd_val_q_i[0][31:16]})[15:0],
                          imd_val_q_i[0][15:0]};
        imd_val_we_o = 2'b01;
        multdiv_result_o = div_sel_i
              ? imd_val_q_i[0][31:0]
              : {MacRes(signed_mode_i[0] and op_a_i[31], op_a_i[31:16],
                        false,                          op_b_i[15:0],
                        {18'b0, imd_val_q_i[0][31:16]})[15:0],
                 imd_val_q_i[0][15:0]};
        valid_o = true;
      until multdiv_ready_id_i;

    elsif mult_en_i and (operator_i == MD_OP_MULH)
      // ── 4-cycle MULH walk (ALBL → ALBH → AHBL → AHBH terminal) ──────
      /// Cycle 2 — ALBH (MULH variant): full 34-b accum, no concat.
      imd_val_d_o[0] = MacRes(false,                          op_a_i[15:0],
                              signed_mode_i[1] and op_b_i[31], op_b_i[31:16],
                              {18'b0, imd_val_q_i[0][31:16]});
      imd_val_we_o = 2'b01;
      wait 1 cycle;

      /// Cycle 3 — AHBL (MULH variant): accum = full 34-b lane 0.
      imd_val_d_o[0] = MacRes(signed_mode_i[0] and op_a_i[31], op_a_i[31:16],
                              false,                          op_b_i[15:0],
                              imd_val_q_i[0]);
      imd_val_we_o = 2'b01;
      wait 1 cycle;

      /// Cycle 4 — AHBH (terminal). The 16-b right-shift between cycles
      /// 3 and 4 is implicit in the accum slice: `imd_val_q_i[0][33:16]`
      /// goes into accum[17:0] and a 16-b sign-extension of
      /// `imd_val_q_i[0][33]` (gated by `signed_mult`) goes into
      /// accum[33:18].
      do
        imd_val_d_o[0] = MacRes(
              signed_mode_i[0] and op_a_i[31], op_a_i[31:16],
              signed_mode_i[1] and op_b_i[31], op_b_i[31:16],
              {{16{(signed_mode_i[0] or signed_mode_i[1]) and imd_val_q_i[0][33]}},
               imd_val_q_i[0][33:16]});
        imd_val_we_o = 2'b01;
        multdiv_result_o = div_sel_i
              ? imd_val_q_i[0][31:0]
              : MacRes(
                  signed_mode_i[0] and op_a_i[31], op_a_i[31:16],
                  signed_mode_i[1] and op_b_i[31], op_b_i[31:16],
                  {{16{(signed_mode_i[0] or signed_mode_i[1]) and imd_val_q_i[0][33]}},
                   imd_val_q_i[0][33:16]})[31:0];
        valid_o = true;
      until multdiv_ready_id_i;

    elsif div_en_i and short_path
      // ── 2-cycle div-by-zero short-circuit (IDLE → FINISH) ───────────
      /// Lane-0 seed was already written on the IDLE-exit edge above
      /// (head-wait body). MD_FINISH: drive the result mux and
      /// `valid_o`; hold until the ID stage acknowledges.
      do
        multdiv_result_o = div_sel_i ? imd_val_q_i[0][31:0]
                                     : 32'h0000_0000;
        valid_o = true;
      until multdiv_ready_id_i;

    else
      // ── 37-cycle long divide ────────────────────────────────────────
      // div_en_i and not short_path. The IDLE-state seed write +
      // div_by_zero_q capture already happened on the wait-exit edge.
      //
      // Sequence: ABS_A → ABS_B → COMP×31 → LAST → CHANGE_SIGN → FINISH.

      /// MD_ABS_A: drive `0 - op_a_i`; capture `op_numerator_q`
      /// (absolute value) and reset `op_quotient_q`. Lane-0 we = 1
      /// (don't-care value, ABS_B will overwrite).
      alu_operand_a_o = {32'h0000_0000, 1'b1};
      alu_operand_b_o = {~op_a_i, 1'b1};
      op_numerator_q <= div_sign_a ? alu_adder_i : op_a_i;
      op_quotient_q  <= 32'h0000_0000;
      imd_val_d_o[0] = imd_val_q_i[0];
      imd_val_we_o = 2'b01;
      wait 1 cycle;

      /// MD_ABS_B: drive `0 - op_b_i`; capture absolute-valued divisor
      /// into lane 1 (top two bits forced 0). Seed lane 0 with
      /// `{33'h0, op_numerator_q[31]}`.
      alu_operand_a_o = {32'h0000_0000, 1'b1};
      alu_operand_b_o = {~op_b_i, 1'b1};
      imd_val_d_o[1] = {2'b00, div_sign_b ? alu_adder_i : op_b_i};
      imd_val_d_o[0] = {33'h0_0000_0000, op_numerator_q[31]};
      imd_val_we_o = 2'b11;
      wait 1 cycle;

      /// MD_COMP × 31. `div_counter_q = 31 - i` (so `i = 0..30`).
      /// Each iteration drives `(partial_rem << 1 | 1) - (divisor << 1
      /// | 1)` and accepts the difference iff `is_greater_equal`,
      /// shifting in `op_numerator_q[30 - i]` at the LSB.
      for i in 0..30
        alu_operand_a_o = {imd_val_q_i[0][31:0], 1'b1};
        alu_operand_b_o = {~imd_val_q_i[1][31:0], 1'b1};
        imd_val_d_o[0] = {1'b0,
                          IsGreaterEqual(imd_val_q_i[0][31],
                                         imd_val_q_i[1][31],
                                         alu_adder_ext_i[32])
                            ? alu_adder_ext_i[32:1]
                            : imd_val_q_i[0][31:0],
                          op_numerator_q[30 - i]};
        imd_val_we_o   = 2'b01;
        op_quotient_q  <= IsGreaterEqual(imd_val_q_i[0][31],
                                         imd_val_q_i[1][31],
                                         alu_adder_ext_i[32])
                            ? (op_quotient_q | (32'h0000_0001 << (31 - i)))
                            : op_quotient_q;
      end for

      /// MD_LAST: 32nd subtract. For DIV write `{2'b0, next_quotient}`
      /// to lane 0; for REM write `{2'b0, next_remainder}`.
      alu_operand_a_o = {imd_val_q_i[0][31:0], 1'b1};
      alu_operand_b_o = {~imd_val_q_i[1][31:0], 1'b1};
      if operator_i == MD_OP_DIV
        imd_val_d_o[0] = {2'b00,
                          IsGreaterEqual(imd_val_q_i[0][31],
                                         imd_val_q_i[1][31],
                                         alu_adder_ext_i[32])
                            ? (op_quotient_q | 32'h0000_0001)
                            : op_quotient_q};
      else
        imd_val_d_o[0] = {2'b00,
                          IsGreaterEqual(imd_val_q_i[0][31],
                                         imd_val_q_i[1][31],
                                         alu_adder_ext_i[32])
                            ? alu_adder_ext_i[32:1]
                            : imd_val_q_i[0][31:0]};
      end if
      imd_val_we_o = 2'b01;
      op_quotient_q <= IsGreaterEqual(imd_val_q_i[0][31],
                                      imd_val_q_i[1][31],
                                      alu_adder_ext_i[32])
                         ? (op_quotient_q | 32'h0000_0001)
                         : op_quotient_q;
      wait 1 cycle;

      /// MD_CHANGE_SIGN: drive `0 - imd_val_q_i[0][31:0]`; conditionally
      /// write the negated value back into lane 0. For DIV, change sign
      /// iff `(div_sign_a ^ div_sign_b) & ~div_by_zero_q`. For REM,
      /// change sign iff `div_sign_a`.
      alu_operand_a_o = {32'h0000_0000, 1'b1};
      alu_operand_b_o = {~imd_val_q_i[0][31:0], 1'b1};
      if (operator_i == MD_OP_DIV)
           ? ((div_sign_a != div_sign_b) and not div_by_zero_q)
           : div_sign_a
        imd_val_d_o[0] = {2'b00, alu_adder_i};
      else
        imd_val_d_o[0] = imd_val_q_i[0];
      end if
      imd_val_we_o = 2'b01;
      wait 1 cycle;

      /// MD_FINISH: assert `valid_o`, expose `imd_val_q_i[0][31:0]`
      /// through the result mux, hold until ID-stage ack. Idle ALU
      /// operand drives are re-emitted (matching the spec's MD_FINISH
      /// behaviour: drive {0,1} and {~op_b, 1}) — values do not affect
      /// the result and they keep the ALU operands quiet at the IDLE
      /// pattern across the FINISH→IDLE edge.
      do
        alu_operand_a_o = {32'h0000_0000, 1'b1};
        alu_operand_b_o = {~op_b_i, 1'b1};
        multdiv_result_o = div_sel_i ? imd_val_q_i[0][31:0]
                                     : 32'h0000_0000;
        valid_o = true;
      until multdiv_ready_id_i;
    end if
  end thread MultdivThread
end module ibex_multdiv_fast
