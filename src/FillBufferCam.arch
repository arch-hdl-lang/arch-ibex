/// FillBufferCam — fill-buffer associative line lookup (R-LK-4).
///
/// DEPTH=NUM_FB=4, KEY_W=22 (the line-tag part of the address,
/// addr[31:10]). Insert on FB allocate, clear on FB release. Searched
/// every cycle from IC1 to detect "branch lands on a line currently
/// being filled".

domain SysDomain
  freq_mhz: 100
end domain SysDomain

cam FillBufferCam
  param DEPTH: const = 4;
  param KEY_W: const = 22;
  port clk: in Clock<SysDomain>;
  port rst: in Reset<Async, Low>;
  port write_valid: in Bool;
  port write_idx:   in UInt<2>;
  port write_key:   in UInt<22>;
  port write_set:   in Bool;
  port search_key:   in  UInt<22>;
  port search_mask:  out UInt<4>;
  port search_any:   out Bool;
  port search_first: out UInt<2>;
end cam FillBufferCam
