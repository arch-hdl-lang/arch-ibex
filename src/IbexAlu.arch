//! ibex_alu — RISC-V integer ALU for the Ibex EX stage.
//!
//! Pure combinational ALU + shared adder + branch comparator. This
//! implementation targets the `RV32B = RV32BNone` configuration: every
//! RV32B-only operator falls through to `result_o = 0` while the adder
//! and comparator side-bands stay valid for downstream consumers
//! (LSU address generator, multdiv, branch unit).
//!
//! refs:
//!   - "specs/alu/spec.md §Adder produces unconditional sum of operands A and B"
//!   - "specs/alu/spec.md §Subtraction and comparison operators drive the adder via two's-complement negation"
//!   - "specs/alu/spec.md §Multdiv mux on the shared adder"
//!   - "specs/alu/spec.md §Equality flag"
//!   - "specs/alu/spec.md §Signed and unsigned comparator"
//!   - "specs/alu/spec.md §Bitwise logic operators"
//!   - "specs/alu/spec.md §Standard shifts (SLL, SRL, SRA)"
//!   - "specs/alu/spec.md §RV32B-inert behavior"
//!   - "specs/alu/spec.md §ADD / SUB operator exposes adder result on result_o"
//!   - "specs/alu/spec.md §Comparison operators expose boolean result"
//!   - "specs/alu/spec.md §imd_val_d_o and imd_val_we_o under RV32BNone"

module ibex_alu
  /// `RV32B` is part of the port contract for parity with the upstream
  /// pipeline; only the `RV32BNone` value (= 0) is exercised here.
  param RV32B: const = 0;

  // ── Inputs ──────────────────────────────────────────────────────────
  port operator_i:          in UInt<7>;
  port operand_a_i:         in UInt<32>;
  port operand_b_i:         in UInt<32>;
  port instr_first_cycle_i: in Bool;
  port multdiv_operand_a_i: in UInt<33>;
  port multdiv_operand_b_i: in UInt<33>;
  port multdiv_sel_i:       in Bool;

  /// Intermediate-value register file from the EX stage. Unused under
  /// `RV32BNone` but consumed in a no-op pass-through below so the
  /// signal is observably read (silences Verilator UNUSED on the
  /// SoC top). Declared as packed Vec so that the ex_block parent's
  /// internal wires (also packed) connect without a type mismatch.
  /// The ex_block boundary ports remain unpacked for SoC interop.
  port imd_val_q_i: in Vec<UInt<32>, 2>;

  // ── Outputs ─────────────────────────────────────────────────────────
  /// Packed Vec to match the parent ex_block's internal wire type.
  port imd_val_d_o: out Vec<UInt<32>, 2>;
  port imd_val_we_o:        out UInt<2>;

  port adder_result_o:      out UInt<32>;
  port adder_result_ext_o:  out UInt<34>;
  port result_o:            out UInt<32>;
  port comparison_result_o: out Bool;
  port is_equal_result_o:   out Bool;

  // ── Operator encoding (see spec §"ALU operator encoding") ───────────
  // Declared as `let` constants of UInt<7> so comparisons against
  // `operator_i` are width-clean and do not trigger Verilator
  // WIDTHEXPAND.
  let ALU_ADD:  UInt<7> = 7'd0;
  let ALU_SUB:  UInt<7> = 7'd1;
  let ALU_XOR:  UInt<7> = 7'd2;
  let ALU_OR:   UInt<7> = 7'd3;
  let ALU_AND:  UInt<7> = 7'd4;
  let ALU_SRA:  UInt<7> = 7'd8;
  let ALU_SRL:  UInt<7> = 7'd9;
  let ALU_SLL:  UInt<7> = 7'd10;
  let ALU_LT:   UInt<7> = 7'd25;
  let ALU_LTU:  UInt<7> = 7'd26;
  let ALU_GE:   UInt<7> = 7'd27;
  let ALU_GEU:  UInt<7> = 7'd28;
  let ALU_EQ:   UInt<7> = 7'd29;
  let ALU_NE:   UInt<7> = 7'd30;
  let ALU_SLT:  UInt<7> = 7'd43;
  let ALU_SLTU: UInt<7> = 7'd44;

  // ── Adder (spec §"Adder produces unconditional sum...",
  //          §"Subtraction and comparison operators drive the adder...",
  //          §"Multdiv mux on the shared adder") ─────────────────────
  /// Subtract-class operators inject the two's-complement negation by
  /// inverting the LSB-0-padded B-side; the LSB-1 on the A-side
  /// supplies the +1 of two's-complement.
  let op_b_negate: Bool =
        (operator_i == ALU_SUB)  or
        (operator_i == ALU_EQ)   or (operator_i == ALU_NE)  or
        (operator_i == ALU_GE)   or (operator_i == ALU_GEU) or
        (operator_i == ALU_LT)   or (operator_i == ALU_LTU) or
        (operator_i == ALU_SLT)  or (operator_i == ALU_SLTU);

  let adder_in_a_int: UInt<33> = {operand_a_i, 1'b1};
  let adder_in_b_pad: UInt<33> = {operand_b_i, 1'b0};
  let adder_in_b_int: UInt<33> = op_b_negate ? ~adder_in_b_pad : adder_in_b_pad;

  /// When `multdiv_sel_i` is high the multdiv unit drives both adder
  /// inputs directly (it has already pre-shifted them by 1 if it
  /// wanted the LSB-1 trick); otherwise we use the integer-ALU
  /// operands above.
  let adder_in_a: UInt<33> = multdiv_sel_i ? multdiv_operand_a_i : adder_in_a_int;
  let adder_in_b: UInt<33> = multdiv_sel_i ? multdiv_operand_b_i : adder_in_b_int;

  /// 33-bit + 33-bit auto-widens to 34 bits; that is exactly the
  /// extended sum the spec mandates on `adder_result_ext_o`.
  let adder_sum_ext: UInt<34> = adder_in_a + adder_in_b;

  let adder_result_ext_o = adder_sum_ext;
  let adder_result_o     = adder_sum_ext[32:1];

  // ── Equality flag (spec §"Equality flag") ───────────────────────────
  /// Unconditionally derived from the adder; downstream picks an
  /// operator that drives the subtract path when it wants `a == b`.
  let is_equal_result_o = (adder_sum_ext[32:1] == 32'h0000_0000);

  // ── Comparator (spec §"Signed and unsigned comparator") ────────────
  let cmp_signed: Bool =
        (operator_i == ALU_GE)  or
        (operator_i == ALU_LT)  or
        (operator_i == ALU_SLT);

  let a_msb: Bool = operand_a_i[31];
  let b_msb: Bool = operand_b_i[31];
  let diff_msb: Bool = adder_sum_ext[32];   // sign bit of (a - b)

  wire is_greater_equal: Bool;
  comb
    if a_msb == b_msb
      is_greater_equal = not diff_msb;
    elsif cmp_signed
      // Signed, MSBs differ: positive a (a_msb = 0) ≥ negative b.
      is_greater_equal = not a_msb;
    else
      // Unsigned, MSBs differ: a is larger iff a's MSB is set.
      is_greater_equal = a_msb;
    end if
  end comb

  wire cmp_result: Bool;
  comb
    // unique match → parallel mux. Per-operator arm; yosys CSEs the
    // shared bodies (GE/GEU; LT/LTU/SLT/SLTU; EQ + default both fold
    // to is_equal_result_o per spec).
    unique match operator_i
      ALU_GE   => cmp_result = is_greater_equal;
      ALU_GEU  => cmp_result = is_greater_equal;
      ALU_LT   => cmp_result = not is_greater_equal;
      ALU_LTU  => cmp_result = not is_greater_equal;
      ALU_SLT  => cmp_result = not is_greater_equal;
      ALU_SLTU => cmp_result = not is_greater_equal;
      ALU_NE   => cmp_result = not is_equal_result_o;
      // Spec: ALU_EQ and the catch-all default both fold to is_equal_result_o.
      ALU_EQ   => cmp_result = is_equal_result_o;
      _        => cmp_result = is_equal_result_o;
    end match
  end comb

  let comparison_result_o = cmp_result;

  // ── Shifter (spec §"Standard shifts (SLL, SRL, SRA)") ──────────────
  /// Per spec §Notes, `instr_first_cycle_i = 1` is the only mode the
  /// pipeline ever issues a single-cycle shift in under `RV32BNone`,
  /// so the shift amount is always the low five bits of operand B.
  /// We still consume `instr_first_cycle_i` below so it does not show
  /// up as Verilator UNUSED on the SoC top.
  let shamt: UInt<5> = operand_b_i[4:0];

  /// Single-shifter implementation (mirrors upstream
  /// `ibex_alu.sv` lines 332-353): always perform a right shift,
  /// reversing operand A in/out for left shifts (SLL). This collapses
  /// what was three independent 32-bit shifters (SLL/SRL/SRA) into
  /// one barrel shifter + bit-reverse muxes, saving ~1 kµm² on
  /// sky130 vs the naive triple-shifter form.
  let shift_left: Bool = (operator_i == ALU_SLL);
  let shift_arith: Bool = (operator_i == ALU_SRA);

  let operand_a_rev: UInt<32> = {
    operand_a_i[0],  operand_a_i[1],  operand_a_i[2],  operand_a_i[3],
    operand_a_i[4],  operand_a_i[5],  operand_a_i[6],  operand_a_i[7],
    operand_a_i[8],  operand_a_i[9],  operand_a_i[10], operand_a_i[11],
    operand_a_i[12], operand_a_i[13], operand_a_i[14], operand_a_i[15],
    operand_a_i[16], operand_a_i[17], operand_a_i[18], operand_a_i[19],
    operand_a_i[20], operand_a_i[21], operand_a_i[22], operand_a_i[23],
    operand_a_i[24], operand_a_i[25], operand_a_i[26], operand_a_i[27],
    operand_a_i[28], operand_a_i[29], operand_a_i[30], operand_a_i[31]
  };

  let shift_operand: UInt<32> = shift_left ? operand_a_rev : operand_a_i;
  let shift_msb_ext: UInt<1> = (shift_arith and shift_operand[31]) ? 1'b1 : 1'b0;
  let shift_in_signed: SInt<33> = signed({shift_msb_ext, shift_operand});
  let shift_out_signed: SInt<33> = shift_in_signed >> shamt;
  let shift_out_ext: UInt<33> = unsigned(shift_out_signed);
  let shift_out: UInt<32> = shift_out_ext[31:0];

  let shift_out_rev: UInt<32> = {
    shift_out[0],  shift_out[1],  shift_out[2],  shift_out[3],
    shift_out[4],  shift_out[5],  shift_out[6],  shift_out[7],
    shift_out[8],  shift_out[9],  shift_out[10], shift_out[11],
    shift_out[12], shift_out[13], shift_out[14], shift_out[15],
    shift_out[16], shift_out[17], shift_out[18], shift_out[19],
    shift_out[20], shift_out[21], shift_out[22], shift_out[23],
    shift_out[24], shift_out[25], shift_out[26], shift_out[27],
    shift_out[28], shift_out[29], shift_out[30], shift_out[31]
  };

  let shift_result: UInt<32> = shift_left ? shift_out_rev : shift_out;

  // ── Result mux (spec §"ADD / SUB operator exposes adder result...",
  //               §"Comparison operators expose boolean result",
  //               §"Bitwise logic operators",
  //               §"Standard shifts...",
  //               §"RV32B-inert behavior") ────────────────────────────
  wire result_w: UInt<32>;
  comb
    // unique match → SV `unique case`, which yosys-slang lowers to a
    // parallel mux (vs the priority encoder of `if/elsif`). One arm
    // per operator since arch HDL match arms support a single pattern.
    // Identical bodies (ADD/SUB share adder; SLL/SRL/SRA share shifter;
    // 8 compare ops share cmp_result) are CSE'd downstream by yosys.
    unique match operator_i
      ALU_ADD  => result_w = adder_sum_ext[32:1];
      ALU_SUB  => result_w = adder_sum_ext[32:1];
      ALU_AND  => result_w = operand_a_i & operand_b_i;
      ALU_OR   => result_w = operand_a_i | operand_b_i;
      ALU_XOR  => result_w = operand_a_i ^ operand_b_i;
      ALU_SLL  => result_w = shift_result;
      ALU_SRL  => result_w = shift_result;
      ALU_SRA  => result_w = shift_result;
      ALU_EQ   => result_w = {31'b0, cmp_result};
      ALU_NE   => result_w = {31'b0, cmp_result};
      ALU_GE   => result_w = {31'b0, cmp_result};
      ALU_GEU  => result_w = {31'b0, cmp_result};
      ALU_LT   => result_w = {31'b0, cmp_result};
      ALU_LTU  => result_w = {31'b0, cmp_result};
      ALU_SLT  => result_w = {31'b0, cmp_result};
      ALU_SLTU => result_w = {31'b0, cmp_result};
      // RV32B-inert: every RV32B-only operator yields zero on result_o
      // under RV32BNone (spec §"RV32B-inert behavior").
      _        => result_w = 32'h0000_0000;
    end match
  end comb

  let result_o = result_w;

  // ── Intermediate-value pass-through (spec §"imd_val_d_o and
  //     imd_val_we_o under RV32BNone") ───────────────────────────────
  /// Outputs are tied to zero per spec; the `_q*_unused` helpers fan
  /// the (otherwise unused) `imd_val_q_i` lanes into a sink so they
  /// are observably consumed at the SoC level.
  let _q0_unused: UInt<32> = imd_val_q_i[0];
  let _q1_unused: UInt<32> = imd_val_q_i[1];

  comb
    imd_val_d_o[0] = 32'h0000_0000;
    imd_val_d_o[1] = 32'h0000_0000;
    imd_val_we_o   = 2'b00;
  end comb

  /// `instr_first_cycle_i` is part of the contract but does not change
  /// the `RV32BNone` shift amount. Touch it here so it is not flagged
  /// as UNUSED at the SoC top.
  let _ifc_unused: Bool = instr_first_cycle_i;
end module ibex_alu
