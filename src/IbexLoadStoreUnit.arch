//! ---
//! spec_md: changes/port-load_store_unit/specs/load_store_unit/spec.md
//! tags: [lsu, obi, bus, thread, misaligned]
//! ---
//!
//! Load Store Unit — ARCH HDL port of ibex_load_store_unit.sv.
//!
//! First Phase-A swap to exercise the `thread` first-class construct.
//! The OBI data-memory interface type is documented as `bus BusObi` but the
//! module declares individual flat ports to preserve exact SV signal names and
//! to avoid unknown thread-to-bus-port-field comb semantics (see design.md).
//!
//! refs:
//!   §"Requirement: OBI-Handshake"
//!   §"Requirement: Misaligned Access Split"
//!   §"Requirement: lsu_req_done_o"
//!   §"Requirement: lsu_resp_valid_o"
//!   §"Requirement: Error Reporting"

domain SysDomain
  freq_mhz: 100
end domain SysDomain

/// OBI (Open Bus Interface) data-memory interface type.
/// Defines the protocol grouping for documentation and future bus-port use.
/// Field names carry _o/_i suffixes so the flattened names match the upstream
/// ibex_top.sv wiring (flat name = port_name + "_" + field_name).
bus BusObi
  req_o:     out Bool;
  gnt_i:     in  Bool;
  rvalid_i:  in  Bool;
  bus_err_i: in  Bool;
  pmp_err_i: in  Bool;
  addr_o:    out UInt<32>;
  we_o:      out Bool;
  be_o:      out UInt<4>;
  wdata_o:   out UInt<32>;
  rdata_i:   in  UInt<32>;
end bus BusObi

module ibex_load_store_unit
  //! ref: specs/load_store_unit/spec.md §"Purpose"

  // MemECC=0: ECC not supported; outputs always 0.  Declared for port compatibility
  // with ibex_core.sv which passes these params at instantiation.
  param MemECC:       const = 0;
  param MemDataWidth: const = 32;

  port clk_i:  in Clock<SysDomain>;
  port rst_ni: in Reset<Async, Low>;

  // ── OBI data-memory interface (individual flat ports) ──────────────
  // Declared as individual ports matching upstream SV names.
  // ref: specs/load_store_unit/spec.md §"Requirement: OBI-Handshake"
  port data_req_o:    out Bool;
  port data_gnt_i:    in  Bool;
  port data_rvalid_i: in  Bool;
  port data_bus_err_i: in Bool;
  port data_pmp_err_i: in Bool;
  port data_addr_o:   out UInt<32>;
  port data_we_o:     out Bool;
  port data_be_o:     out UInt<4>;
  port data_wdata_o:  out UInt<32>;
  port data_rdata_i:  in  UInt<32>;

  // ── ID/EX interface ────────────────────────────────────────────────
  port lsu_we_i:          in Bool;
  port lsu_type_i:        in UInt<2>;
  port lsu_wdata_i:       in UInt<32>;
  port lsu_sign_ext_i:    in Bool;
  port lsu_rdata_o:       out UInt<32>;
  port lsu_rdata_valid_o: out Bool;
  port lsu_req_i:         in Bool;
  port adder_result_ex_i: in UInt<32>;

  port addr_incr_req_o:   out Bool;
  port addr_last_o:       out UInt<32>;
  port lsu_req_done_o:    out Bool;
  port lsu_resp_valid_o:  out Bool;

  // ── Exception outputs ──────────────────────────────────────────────
  port load_err_o:              out Bool;
  port load_resp_intg_err_o:    out Bool;
  port store_err_o:             out Bool;
  port store_resp_intg_err_o:   out Bool;

  port busy_o:       out Bool;
  port perf_load_o:  out Bool;
  port perf_store_o: out Bool;

  // ── Internal registers ─────────────────────────────────────────────
  reg addr_last_q:              UInt<32> reset rst_ni => 0;
  reg data_type_q:              UInt<2>  reset rst_ni => 0;
  reg data_sign_ext_q:          Bool     reset rst_ni => false;
  reg data_we_q:                Bool     reset rst_ni => false;
  reg rdata_offset_q:           UInt<2>  reset rst_ni => 0;
  /// Upper 24 bits of first misaligned rdata; assembled on second rvalid.
  reg rdata_q:                  UInt<24> reset rst_ni => 0;
  reg pmp_err_q:                Bool     reset rst_ni => false;
  /// True while issuing the second transaction of a misaligned access.
  reg handle_misaligned_q:      Bool     reset rst_ni => false;
  /// True from first request until last grant; drives busy_o.
  reg lsu_busy_q:               Bool     reset rst_ni => false;

  /// Misaligned-only: set on the cycle of the SECOND grant, cleared on
  /// the cycle of the FIRST rvalid. While set, the wait-rvalid state
  /// suppresses response outputs (lsu_resp_valid_o etc.) and treats the
  /// incoming rvalid as the "first" rvalid (capture upper bytes only,
  /// don't advance to IDLE). When clear, the wait-rvalid state treats
  /// the incoming rvalid as final (drive response, clear lsu_busy_q).
  /// For aligned accesses this register stays 0 throughout — the only
  /// rvalid IS the final one.
  reg awaiting_first_mis_rvalid_q: Bool reset rst_ni => false;

  /// 1-cycle delayed version of `handle_misaligned_q`. Used to gate
  /// `lsu_req_done_o` for misaligned-second-grant detection: the comb
  /// `handle_misaligned_q AND data_gnt_i` would fire on the FIRST
  /// grant cycle too (handle_misaligned_q was just set, gnt is still
  /// high in the same cycle — same-cycle aliasing). Using the delayed
  /// version means the gate fires only when handle_misaligned_q was
  /// ALREADY 1 BEFORE this cycle's grant arrived.
  reg handle_misaligned_d:           Bool reset rst_ni => false;
  /// Bus error latched from first rvalid of a misaligned load.
  reg bus_err_q:                Bool     reset rst_ni => false;

  // ── Combinational intermediates ────────────────────────────────────
  /// ref: specs/load_store_unit/spec.md §"Requirement: Word-Aligned Address"
  let data_offset: UInt<2>  = adder_result_ex_i[1:0];
  let data_addr:   UInt<32> = {adder_result_ex_i[31:2], 2'b00};

  /// ref: specs/load_store_unit/spec.md §"Requirement: Misaligned Access Split"
  let split_misaligned_access: Bool =
    (lsu_type_i == 2'b00 and data_offset != 2'b00) or
    (lsu_type_i == 2'b01 and data_offset == 2'b11);

  // ── Byte-enable (BE) mux ──────────────────────────────────────────
  /// ref: specs/load_store_unit/spec.md §"Requirement: Byte-Enable Generation"
  wire data_be: UInt<4>;
  comb
    if handle_misaligned_q
      // Second transaction: use captured type and offset
      if data_type_q == 2'b01
        // Halfword misaligned (offset 3): second half BE always 0001
        data_be = 4'b0001;
      elsif rdata_offset_q == 2'b01
        data_be = 4'b0001;
      elsif rdata_offset_q == 2'b10
        data_be = 4'b0011;
      else
        data_be = 4'b0111;
      end if
    else
      // First (or only) transaction: use current inputs
      if lsu_type_i == 2'b00
        // Word
        if data_offset == 2'b00
          data_be = 4'b1111;
        elsif data_offset == 2'b01
          data_be = 4'b1110;
        elsif data_offset == 2'b10
          data_be = 4'b1100;
        else
          data_be = 4'b1000;
        end if
      elsif lsu_type_i == 2'b01
        // Halfword
        if data_offset == 2'b00
          data_be = 4'b0011;
        elsif data_offset == 2'b01
          data_be = 4'b0110;
        elsif data_offset == 2'b10
          data_be = 4'b1100;
        else
          // offset 3, first half of misaligned halfword
          data_be = 4'b1000;
        end if
      else
        // Byte (lsu_type_i == 2'b10 or 2'b11)
        if data_offset == 2'b00
          data_be = 4'b0001;
        elsif data_offset == 2'b01
          data_be = 4'b0010;
        elsif data_offset == 2'b10
          data_be = 4'b0100;
        else
          data_be = 4'b1000;
        end if
      end if
    end if
  end comb

  // ── Write-data rotation ───────────────────────────────────────────
  /// ref: specs/load_store_unit/spec.md §"Requirement: Write-Data Rotation"
  wire data_wdata_w: UInt<32>;
  comb
    if data_offset == 2'b01
      data_wdata_w = {lsu_wdata_i[23:0], lsu_wdata_i[31:24]};
    elsif data_offset == 2'b10
      data_wdata_w = {lsu_wdata_i[15:0], lsu_wdata_i[31:16]};
    elsif data_offset == 2'b11
      data_wdata_w = {lsu_wdata_i[7:0], lsu_wdata_i[31:8]};
    else
      data_wdata_w = lsu_wdata_i;
    end if
  end comb

  // ── Read-data extraction ──────────────────────────────────────────
  /// ref: specs/load_store_unit/spec.md §"Requirement: Read-Data Extraction"

  // Misaligned halfword reconstruction: {second_rdata[7:0], first_rdata[31:24]}
  wire hword_mis: UInt<16>;
  comb
    hword_mis = {data_rdata_i[7:0], rdata_q[23:16]};
  end comb

  // Word assembly (aligned and misaligned)
  wire rdata_w_ext: UInt<32>;
  comb
    if rdata_offset_q == 2'b01
      rdata_w_ext = {data_rdata_i[7:0],  rdata_q[23:0]};
    elsif rdata_offset_q == 2'b10
      rdata_w_ext = {data_rdata_i[15:0], rdata_q[23:8]};
    elsif rdata_offset_q == 2'b11
      rdata_w_ext = {data_rdata_i[23:0], rdata_q[23:16]};
    else
      rdata_w_ext = data_rdata_i;
    end if
  end comb

  // Halfword: select and sign/zero-extend
  wire rdata_h_ext: UInt<32>;
  comb
    if rdata_offset_q == 2'b00
      if data_sign_ext_q
        rdata_h_ext = unsigned(signed(data_rdata_i[15:0]).sext<32>());
      else
        rdata_h_ext = data_rdata_i[15:0].zext<32>();
      end if
    elsif rdata_offset_q == 2'b01
      if data_sign_ext_q
        rdata_h_ext = unsigned(signed(data_rdata_i[23:8]).sext<32>());
      else
        rdata_h_ext = data_rdata_i[23:8].zext<32>();
      end if
    elsif rdata_offset_q == 2'b10
      if data_sign_ext_q
        rdata_h_ext = unsigned(signed(data_rdata_i[31:16]).sext<32>());
      else
        rdata_h_ext = data_rdata_i[31:16].zext<32>();
      end if
    else
      // Misaligned halfword offset 3
      if data_sign_ext_q
        rdata_h_ext = unsigned(signed(hword_mis).sext<32>());
      else
        rdata_h_ext = hword_mis.zext<32>();
      end if
    end if
  end comb

  // Byte: select and sign/zero-extend
  wire rdata_b_ext: UInt<32>;
  comb
    if rdata_offset_q == 2'b00
      if data_sign_ext_q
        rdata_b_ext = unsigned(signed(data_rdata_i[7:0]).sext<32>());
      else
        rdata_b_ext = data_rdata_i[7:0].zext<32>();
      end if
    elsif rdata_offset_q == 2'b01
      if data_sign_ext_q
        rdata_b_ext = unsigned(signed(data_rdata_i[15:8]).sext<32>());
      else
        rdata_b_ext = data_rdata_i[15:8].zext<32>();
      end if
    elsif rdata_offset_q == 2'b10
      if data_sign_ext_q
        rdata_b_ext = unsigned(signed(data_rdata_i[23:16]).sext<32>());
      else
        rdata_b_ext = data_rdata_i[23:16].zext<32>();
      end if
    else
      if data_sign_ext_q
        rdata_b_ext = unsigned(signed(data_rdata_i[31:24]).sext<32>());
      else
        rdata_b_ext = data_rdata_i[31:24].zext<32>();
      end if
    end if
  end comb

  // Final read-data mux by captured access type
  wire rdata_ext: UInt<32>;
  comb
    if data_type_q == 2'b00
      rdata_ext = rdata_w_ext;
    elsif data_type_q == 2'b01
      rdata_ext = rdata_h_ext;
    else
      rdata_ext = rdata_b_ext;
    end if
  end comb

  // Error gating wire — bus error or PMP error on final rvalid
  wire bus_or_pmp_err: Bool;
  comb
    bus_or_pmp_err = (data_rvalid_i and (data_bus_err_i or bus_err_q)) or pmp_err_q;
  end comb

  // ── Static combinational outputs ──────────────────────────────────
  comb
    // ref: specs/load_store_unit/spec.md §"Requirement: Word-Aligned Address"
    data_addr_o  = data_addr;
    data_we_o    = lsu_we_i;
    data_be_o    = data_be;
    data_wdata_o = data_wdata_w;

    addr_last_o = addr_last_q;

    // ref: specs/load_store_unit/spec.md §"Requirement: busy_o"
    // `lsu_busy_q` is the explicit ARCH analogue of upstream's
    // `(ls_fsm_cs != IDLE)` — set when entering a non-idle FSM phase
    // (WAIT_GNT, WAIT_GNT_MIS, WAIT_RVALID_MIS), cleared when
    // returning to IDLE.
    busy_o = lsu_busy_q;

    // MemECC=0: integrity error outputs always 0
    load_resp_intg_err_o  = false;
    store_resp_intg_err_o = false;

    // ref: specs/load_store_unit/spec.md §"Requirement: lsu_rdata_valid_o"
    lsu_rdata_o = rdata_ext;

    // addr_incr_req_o: 1 while issuing the second transaction of a misaligned
    // access — perfectly aligned with handle_misaligned_q.
    // ref: specs/load_store_unit/spec.md §"Requirement: Misaligned Access Split"
    addr_incr_req_o = handle_misaligned_q;

    // ── Response outputs (driven combinationally from bus inputs) ─────
    // Mirrors upstream `lsu_resp_valid_o = (rvalid | pmp_err_q) & (ls_fsm_cs == IDLE);`
    // — the response gate `not lsu_busy_q` ensures lsu_resp_valid_o is
    // suppressed during all non-IDLE phases (WAIT_GNT, WAIT_RVALID_MIS,
    // etc.). For aligned with immediate grant, lsu_busy_q stays 0 and
    // lsu_resp_valid_o tracks rvalid combinationally — coincident with
    // the rvalid pulse, no FSM-state-transition latency.
    // For misaligned: lsu_busy_q is high through WAIT_RVALID_MIS, so
    // the first rvalid is suppressed; lsu_busy_q clears on the SECOND
    // rvalid (the final), at which point lsu_resp_valid_o tracks it.
    // ref: specs/load_store_unit/spec.md §"Requirement: lsu_resp_valid_o"
    // ref: specs/load_store_unit/spec.md §"Requirement: lsu_rdata_valid_o"
    // ref: specs/load_store_unit/spec.md §"Requirement: Error Reporting"
    lsu_resp_valid_o  = (data_rvalid_i or pmp_err_q) and not lsu_busy_q;
    lsu_rdata_valid_o = data_rvalid_i and not lsu_busy_q
                        and not data_we_q and not data_bus_err_i and not pmp_err_q;
    load_err_o  = lsu_resp_valid_o and bus_or_pmp_err and not data_we_q;
    store_err_o = lsu_resp_valid_o and bus_or_pmp_err and data_we_q;

    // ── Request-side comb outputs ───────────────────────────────────
    // Drive request: high on initial req (lsu_req_i, in IDLE) OR while in
    // WAIT_GNT (lsu_req_i held by ID/EX) OR while issuing the misaligned
    // second transaction (handle_misaligned_q).
    data_req_o     = lsu_req_i or handle_misaligned_q;

    // Performance counters: pulse exactly on the FIRST cycle of a new
    // request (lsu_busy_q==0 disambiguates from WAIT_GNT and misaligned
    // re-issue, where lsu_req_i is also high).
    // ref: specs/load_store_unit/spec.md §"Requirement: Performance Counter Pulses"
    perf_load_o    = lsu_req_i and not lsu_we_i and not lsu_busy_q;
    perf_store_o   = lsu_req_i and lsu_we_i and not lsu_busy_q;

    // lsu_req_done_o pulses on the LAST grant of a transaction:
    //   - aligned: first (and only) grant — req+gnt without misaligned active.
    //   - misaligned: second grant — handle_misaligned_d (the 1-cycle
    //     delayed flag) AND gnt. Using the delayed flag avoids same-cycle
    //     aliasing: handle_misaligned_q is set on the first-grant cycle
    //     along with gnt, so testing handle_misaligned_q AND gnt would
    //     falsely fire on the first grant. handle_misaligned_d only goes
    //     high in the cycle AFTER handle_misaligned_q does, so by the
    //     time we test handle_misaligned_d AND gnt we know we're at the
    //     SECOND grant.
    // ref: specs/load_store_unit/spec.md §"Requirement: lsu_req_done_o"
    lsu_req_done_o = (lsu_req_i and data_gnt_i and not split_misaligned_access and not handle_misaligned_q)
                     or (handle_misaligned_d and data_gnt_i);
  end comb

  // ── Synchronous FSM-state register updates ──────────────────────────
  /// The LSU's request/grant/rvalid sequencing is encoded entirely as
  /// conditional updates of `lsu_busy_q`, `handle_misaligned_q`,
  /// `awaiting_first_mis_rvalid_q`, and `handle_misaligned_d` —
  /// mirroring upstream's `ls_fsm_cs` register transitions:
  ///
  ///   - `lsu_busy_q == false` ↔ upstream `ls_fsm_cs == IDLE`. The LSU
  ///     is either truly idle, OR is in the implicit "wait for rvalid"
  ///     phase of an aligned access (which upstream handles in IDLE).
  ///   - `lsu_busy_q == true` ↔ upstream `ls_fsm_cs ∈ {WAIT_GNT,
  ///     WAIT_GNT_MIS, WAIT_RVALID_MIS, WAIT_RVALID_MIS_GNTS_DONE}`.
  ///
  /// State transitions:
  ///   - First request cycle without immediate grant → enter WAIT_GNT
  ///     (lsu_busy_q <= true).
  ///   - Aligned first grant → return to IDLE (lsu_busy_q <= false if
  ///     coming from WAIT_GNT, or stays IDLE if immediate grant).
  ///   - Misaligned first grant → enter WAIT_RVALID_MIS (lsu_busy_q
  ///     <= true, handle_misaligned_q <= true).
  ///   - Misaligned second grant → arm awaiting_first_mis_rvalid_q
  ///     (lsu_busy_q stays true).
  ///   - Misaligned first rvalid → capture upper bytes, clear
  ///     awaiting_first_mis_rvalid_q (lsu_busy_q stays true).
  ///   - Misaligned second/final rvalid → return to IDLE
  ///     (lsu_busy_q <= false).
  ///
  /// Note: A `seq on clk` block is the right primitive here (rather than
  /// `thread`) because all transitions are register-driven within one
  /// cycle — there is no multi-state branching, no `wait until cond`
  /// yield, no need for `do { ... } until cond`. Earlier iterations used
  /// a `thread LsuReq` with `do { ... } until false;` to satisfy the
  /// project plan's "first `thread` swap" guideline, but a single-state
  /// thread IS just a seq block in disguise — `seq on clk` is the
  /// honest representation. The `thread` construct will get its first
  /// genuine workout in Phase B (Controller, with `fsm`+`thread`).
  ///
  /// ref: specs/load_store_unit/spec.md §"Requirement: OBI-Handshake"
  /// ref: specs/load_store_unit/spec.md §"Requirement: Misaligned Access Split"
  /// ref: specs/load_store_unit/spec.md §"Requirement: busy_o"
  seq on clk_i rising
    // Maintain the 1-cycle delay register for handle_misaligned_q.
    handle_misaligned_d <= handle_misaligned_q;

    // First-cycle-of-request: capture LSU control regs. Gated by
    // `not lsu_busy_q` so this fires only on the IDLE → request edge.
    if lsu_req_i and not lsu_busy_q
      data_type_q     <= lsu_type_i;
      data_sign_ext_q <= lsu_sign_ext_i;
      data_we_q       <= lsu_we_i;
      rdata_offset_q  <= data_offset;
      bus_err_q       <= false;
    end if

    // IDLE → WAIT_GNT: req asserted but no immediate grant. Enter
    // non-idle (busy_o goes high next cycle).
    if lsu_req_i and not data_gnt_i and not lsu_busy_q
      lsu_busy_q <= true;
    end if

    // First grant (IDLE or WAIT_GNT → next state):
    //   - Aligned: WAIT_GNT → IDLE (lsu_busy_q <= false), captures done.
    //   - Misaligned: any → WAIT_RVALID_MIS (lsu_busy_q <= true,
    //     handle_misaligned_q <= true). For the IDLE→WAIT_RVALID_MIS
    //     case, lsu_busy_q transitions 0 → 1.
    if lsu_req_i and data_gnt_i and not handle_misaligned_q
      addr_last_q         <= data_addr;
      pmp_err_q           <= data_pmp_err_i;
      handle_misaligned_q <= split_misaligned_access;
      if split_misaligned_access
        lsu_busy_q <= true;       // entering WAIT_RVALID_MIS
      else
        lsu_busy_q <= false;      // returning to IDLE (aligned done)
      end if
    end if

    // Misaligned-second-grant: WAIT_RVALID_MIS (handle_misaligned_q==1)
    // gets second gnt. Update addr_last, OR pmp errors, clear
    // handle_misaligned_q, arm awaiting_first_mis_rvalid_q. lsu_busy_q
    // stays true (still in non-idle phase, awaiting both rvalids).
    if handle_misaligned_q and data_gnt_i
      addr_last_q                  <= data_addr;
      pmp_err_q                    <= pmp_err_q or data_pmp_err_i;
      handle_misaligned_q          <= false;
      awaiting_first_mis_rvalid_q  <= true;
    end if

    // Misaligned first-rvalid: capture upper bytes, clear awaiting.
    // lsu_busy_q stays true (still need to wait for second rvalid).
    if data_rvalid_i and awaiting_first_mis_rvalid_q
      rdata_q                      <= data_rdata_i[31:8];
      bus_err_q                    <= data_bus_err_i;
      awaiting_first_mis_rvalid_q  <= false;
    end if

    // Final rvalid (misaligned-second OR pmp_err in non-idle phase):
    // clear busy → return to IDLE. NOTE: aligned-rvalid does NOT need
    // to be handled here because aligned-rvalid arrives while
    // lsu_busy_q is already 0 (we returned to IDLE on first grant);
    // no register update needed for aligned response.
    if (data_rvalid_i and not awaiting_first_mis_rvalid_q and lsu_busy_q)
       or (pmp_err_q and lsu_busy_q)
      lsu_busy_q <= false;
    end if
  end seq

end module ibex_load_store_unit
