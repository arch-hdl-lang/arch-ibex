/// IbexController — pipeline controller FSM for the Ibex core.
///
/// Sequences the processor through reset → boot → fetch → decode/execute,
/// and arbitrates every asynchronous disruption to that loop:
/// external interrupts, debug requests, exceptions, WFI sleep,
/// CSR-induced pipeline flushes, MRET/DRET returns.
///
/// Spec: changes/port-controller/specs/controller/spec.md
///   - 12 Requirements
///   - 9 Integration constraints
///   - 9-active-state FSM: RESET, BOOT_SET, WAIT_SLEEP, SLEEP,
///     FIRST_FETCH, DECODE, FLUSH, IRQ_TAKEN, DBG_TAKEN_IF, DBG_TAKEN_ID
///
/// SoC parameter pinning:
///   WritebackStage = 0, BranchPredictor = 0, MemECC = 0
///
/// Construct: `fsm` (Spec §"Requirement 1–12" — multi-state FSM with
/// state-dependent outputs). The latched decoder/LSU flops + mode
/// flops are declared at fsm scope alongside the state.

/// `ExcCause` / `Irqs` come from `IbexPkg` so the SoC can link
/// controller + if_stage + id_stage into one elaboration without
/// `Duplicate declaration of TYPEDEF` errors (was a B5-blocking issue
/// before the package extraction).
use IbexCoreSharedPkg;

/// Debug-cause register (3-bit upstream `dbg_cause_e`).
/// Constants used:
///   DBG_CAUSE_NONE    = 3'b000
///   DBG_CAUSE_EBREAK  = 3'b001
///   DBG_CAUSE_TRIGGER = 3'b010
///   DBG_CAUSE_HALTREQ = 3'b011
///   DBG_CAUSE_STEP    = 3'b100
fsm ibex_controller
  /// SoC parameter pinning. All three are pinned to 0 in this swap;
  /// declared so the upstream `ibex_top.sv` instantiation site doesn't
  /// raise PINNOTFOUND on its parameter bindings.
  param WritebackStage[0:0]: const = 1'd0;
  param BranchPredictor[0:0]: const = 1'd0;
  param MemECC[0:0]: const = 1'd0;

  // ── Clock + reset ─────────────────────────────────────────────────
  port clk_i: in Clock<SysDomain>;
  port rst_ni: in Reset<Async, Low>;

  // ── Decoder flag inputs ───────────────────────────────────────────
  port illegal_insn_i: in Bool;
  port ecall_insn_i: in Bool;
  port mret_insn_i: in Bool;
  port dret_insn_i: in Bool;
  port wfi_insn_i: in Bool;
  port ebrk_insn_i: in Bool;
  port csr_pipe_flush_i: in Bool;

  // ── ID-stage instruction context ──────────────────────────────────
  port instr_valid_i: in Bool;
  port instr_i: in UInt<32>;
  port instr_compressed_i: in UInt<16>;
  port instr_is_compressed_i: in Bool;
  port instr_bp_taken_i: in Bool;
  port instr_fetch_err_i: in Bool;
  port instr_fetch_err_plus2_i: in Bool;
  port pc_id_i: in UInt<32>;
  port instr_exec_i: in Bool;

  // ── LSU side ──────────────────────────────────────────────────────
  port lsu_addr_last_i: in UInt<32>;
  port load_err_i: in Bool;
  port store_err_i: in Bool;
  port mem_resp_intg_err_i: in Bool;

  // ── Branch / jump ─────────────────────────────────────────────────
  port branch_set_i: in Bool;
  port branch_not_set_i: in Bool;
  port jump_set_i: in Bool;

  // ── CSR / IRQ ─────────────────────────────────────────────────────
  port csr_mstatus_mie_i: in Bool;
  port irq_pending_i: in Bool;
  port irqs_i: in Irqs;
  port irq_nm_ext_i: in Bool;

  // ── Debug ─────────────────────────────────────────────────────────
  port debug_req_i: in Bool;
  port debug_single_step_i: in Bool;
  port debug_ebreakm_i: in Bool;
  port debug_ebreaku_i: in Bool;
  port trigger_match_i: in Bool;

  // ── Privilege ─────────────────────────────────────────────────────
  port priv_mode_i: in UInt<2>;

  // ── Stalls ────────────────────────────────────────────────────────
  port stall_id_i: in Bool;
  port stall_wb_i: in Bool;
  port ready_wb_i: in Bool;

  // ── Outputs ───────────────────────────────────────────────────────
  port ctrl_busy_o: out Bool;
  port instr_valid_clear_o: out Bool;
  port id_in_ready_o: out Bool;
  port controller_run_o: out Bool;
  port instr_req_o: out Bool;
  port pc_set_o: out Bool;
  port pc_mux_o: out UInt<3>;
  port nt_branch_mispredict_o: out Bool;
  port exc_pc_mux_o: out UInt<2>;
  port exc_cause_o: out ExcCause;
  port wb_exception_o: out Bool;
  port id_exception_o: out Bool;
  port nmi_mode_o: out Bool;
  port debug_cause_o: out UInt<3>;
  port debug_csr_save_o: out Bool;
  port debug_mode_o: out Bool;
  port debug_mode_entering_o: out Bool;
  port csr_save_if_o: out Bool;
  port csr_save_id_o: out Bool;
  port csr_save_wb_o: out Bool;
  port csr_restore_mret_id_o: out Bool;
  port csr_restore_dret_id_o: out Bool;
  port csr_save_cause_o: out Bool;
  port csr_mtval_o: out UInt<32>;
  port flush_id_o: out Bool;
  port perf_jump_o: out Bool;
  port perf_tbranch_o: out Bool;

  // ── Latched state regs (Spec §"Requirement 9") ────────────────────
  /// Only these four flops are latched. All other `*_insn` signals are
  /// combinational `& instr_valid_i` qualifications, NOT flopped.
  reg illegal_insn_q: Bool reset rst_ni => 1'b0;
  reg exc_req_q: Bool reset rst_ni => 1'b0;
  reg load_err_q: Bool reset rst_ni => 1'b0;
  reg store_err_q: Bool reset rst_ni => 1'b0;

  // ── Mode regs (Spec §"Requirement 10") ────────────────────────────
  reg debug_mode_q: Bool reset rst_ni => 1'b0;
  reg nmi_mode_q: Bool reset rst_ni => 1'b0;
  reg enter_debug_mode_prio_q: Bool reset rst_ni => 1'b0;
  reg do_single_step_q: Bool reset rst_ni => 1'b0;
  reg debug_cause_q: UInt<3> reset rst_ni => 0;
  reg load_err_prio_q: Bool reset rst_ni => 1'b0;
  reg store_err_prio_q: Bool reset rst_ni => 1'b0;

  // ── State declaration ─────────────────────────────────────────────
  state [
    StReset, StBootSet, StWaitSleep, StSleep, StFirstFetch,
    StDecode, StFlush, StIrqTaken, StDbgTakenIf, StDbgTakenId
  ]
  default state StReset;
  default seq on clk_i rising;

  // ── Combinational helpers (Spec §"Requirement 2", "Requirement 3",
  // "Requirement 4", "Requirement 11") ──────────────────────────────
  /// `*_insn = *_insn_i & instr_valid_i` — comb-qualified, not flopped.
  let mret_insn: Bool       = mret_insn_i and instr_valid_i;
  let dret_insn: Bool       = dret_insn_i and instr_valid_i;
  let wfi_insn: Bool        = wfi_insn_i and instr_valid_i;
  let ebrk_insn: Bool       = ebrk_insn_i and instr_valid_i;
  let ecall_insn: Bool      = ecall_insn_i and instr_valid_i;
  let csr_pipe_flush: Bool  = csr_pipe_flush_i and instr_valid_i;
  let instr_fetch_err: Bool = instr_fetch_err_i and instr_valid_i;

  /// LSU-side exception request — combines load_err and store_err.
  let exc_req_lsu: Bool = store_err_i or load_err_i;

  /// `id_wb_pending = instr_valid_i | ~ready_wb_i` — under WritebackStage=0,
  /// `ready_wb_i = 1`, so this collapses to `instr_valid_i`.
  let id_wb_pending: Bool = instr_valid_i or (not ready_wb_i);

  /// `do_single_step_d = ~debug_mode_q & debug_single_step_i & instr_valid_i`,
  /// held by `do_single_step_q` once the conditions hold (per spec N-4).
  let do_single_step_d: Bool =
    instr_valid_i ? ((not debug_mode_q) and debug_single_step_i) : do_single_step_q;

  /// `enter_debug_mode_prio_d = (debug_req_i | do_single_step_d) & ~debug_mode_q`.
  let enter_debug_mode_prio_d: Bool =
    (debug_req_i or do_single_step_d) and (not debug_mode_q);

  /// `enter_debug_mode = enter_debug_mode_prio_d | (trigger_match_i & ~debug_mode_q)`.
  let enter_debug_mode: Bool =
    enter_debug_mode_prio_d or (trigger_match_i and (not debug_mode_q));

  /// `ebreak_into_debug` — depends on privilege level + dcsr fields.
  let ebreak_into_debug: Bool =
    (priv_mode_i == 2'd3) ? debug_ebreakm_i :
    ((priv_mode_i == 2'd0) ? debug_ebreaku_i : 1'b0);

  /// `irq_enabled = csr_mstatus_mie_i | (priv_mode_i == PRIV_LVL_U)`.
  let irq_enabled: Bool = csr_mstatus_mie_i or (priv_mode_i == 2'd0);

  /// `irq_nm = irq_nm_ext_i` under MemECC=0.
  let irq_nm: Bool = irq_nm_ext_i;

  /// Hierarchical-reference targets used by upstream `ibex_core.sv` for
  /// RVFI / debug visibility. Drive to constants under SoC pinning.
  let irq_nm_int: Bool      = 1'b0;     // MemECC=0 → no internal NMI
  let rvfi_flush_next: Bool = 1'b0;     // RVFI not exercised in this swap

  /// `handle_irq` per spec Requirement 3.
  let handle_irq: Bool =
    (not debug_mode_q) and (not debug_single_step_i) and (not nmi_mode_q)
    and (irq_nm or (irq_pending_i and irq_enabled));

  /// Decoder-output exception request (latched). Gated by `~FLUSH` so
  /// the next-cycle value clears as we enter FLUSH (spec Req 9).
  let in_flush: Bool = false;  // overridden in FLUSH state body
  let illegal_insn_d: Bool = illegal_insn_i and (not in_flush);
  let exc_req_d: Bool =
    (ecall_insn or ebrk_insn or illegal_insn_d or instr_fetch_err)
    and (not in_flush);

  /// `special_req` per spec Requirement 2.
  let special_req_flush_only: Bool = wfi_insn or csr_pipe_flush;
  let special_req_pc_change: Bool =
    mret_insn or dret_insn or exc_req_d or exc_req_lsu;
  let special_req: Bool = special_req_pc_change or special_req_flush_only;

  /// `stall_w = stall_id_i` under WritebackStage=0. (`stall` is reserved.)
  let stall_w: Bool = stall_id_i;

  /// `mfip_id` priority encoder — per spec Requirement 11 (lowest set
  /// bit of `irqs_i.irq_fast[14:0]`). Manual chained-ternary form;
  /// `find_first` on a `UInt<N> as Vec<Bool, N>` cast hit an arch-com
  /// codegen bug for this configuration (the destructured `index` did
  /// not get declared in the emitted SV). Fall back to an explicit
  /// priority encoder.
  let mfip_id: UInt<4> =
    irqs_i.irq_fast[0]  ? 4'd0  :
    irqs_i.irq_fast[1]  ? 4'd1  :
    irqs_i.irq_fast[2]  ? 4'd2  :
    irqs_i.irq_fast[3]  ? 4'd3  :
    irqs_i.irq_fast[4]  ? 4'd4  :
    irqs_i.irq_fast[5]  ? 4'd5  :
    irqs_i.irq_fast[6]  ? 4'd6  :
    irqs_i.irq_fast[7]  ? 4'd7  :
    irqs_i.irq_fast[8]  ? 4'd8  :
    irqs_i.irq_fast[9]  ? 4'd9  :
    irqs_i.irq_fast[10] ? 4'd10 :
    irqs_i.irq_fast[11] ? 4'd11 :
    irqs_i.irq_fast[12] ? 4'd12 :
    irqs_i.irq_fast[13] ? 4'd13 :
    irqs_i.irq_fast[14] ? 4'd14 : 4'd0;

  /// Clean dispatch boundary — DECODE with no stall, no special_req,
  /// no pending ID/WB instruction. Used to gate IRQ + debug entry.
  let clean_dispatch: Bool =
    (not stall_w) and (not special_req) and (not id_wb_pending);

  /// IRQ pending on a clean dispatch (DECODE) or in FIRST_FETCH —
  /// exposed as a wire used by transitions.
  let take_irq_in_decode: Bool = clean_dispatch and (not enter_debug_mode) and handle_irq;
  let take_dbg_in_decode: Bool = clean_dispatch and enter_debug_mode;
  let take_flush_in_decode: Bool = special_req and ready_wb_i;

  /// `halt_if` per upstream lines 612 & 622/631: IF must be halted
  ///   (a) while we wait for ID/WB to drain  (handle_irq & (stall|id_wb_pending))
  ///   (b) on the very cycle IRQ/debug entry fires (handle_irq & clean_dispatch)
  /// without (b), the next instruction sneaks into ID before IRQ_TAKEN
  /// fires, advancing pc_if by one — mepc then points past the
  /// interrupted instruction and mret resumes one ahead.
  /// special_req=1 takes the FLUSH path instead, so IRQ-driven halt_if
  /// doesn't apply there.
  let halt_if_decode: Bool =
    (enter_debug_mode or handle_irq) and (not special_req);

  // ── Default block (Spec §"Requirement 12") ────────────────────────
  /// Defaults match upstream's combinational always-block defaults.
  /// State bodies override what differs.
  default
    comb
      ctrl_busy_o            = 1'b1;
      instr_valid_clear_o    = 1'b0;
      id_in_ready_o          = 1'b0;
      controller_run_o       = 1'b0;
      // Default to 1 per upstream line 455. RESET / WAIT_SLEEP / SLEEP
      // override to 0. DECODE / IRQ_TAKEN / FLUSH / DBG_TAKEN_*
      // inherit 1 — keeping prefetch active across state transitions
      // is needed for the FSM to observe new dispatch boundaries.
      instr_req_o            = 1'b1;
      pc_set_o               = 1'b0;
      pc_mux_o               = 3'd0;            // PC_BOOT
      nt_branch_mispredict_o = 1'b0;
      exc_pc_mux_o           = 2'd1;            // EXC_PC_IRQ
      exc_cause_o            = ExcCause { irq_int: 1'b0, irq_ext: 1'b0, lower_cause: 5'd0 };
      wb_exception_o         = 1'b0;
      id_exception_o         = exc_req_d;
      nmi_mode_o             = nmi_mode_q;
      debug_cause_o          = debug_cause_q;
      debug_csr_save_o       = 1'b0;
      debug_mode_o           = debug_mode_q;
      debug_mode_entering_o  = 1'b0;
      csr_save_if_o          = 1'b0;
      csr_save_id_o          = 1'b0;
      csr_save_wb_o          = 1'b0;
      csr_restore_mret_id_o  = 1'b0;
      csr_restore_dret_id_o  = 1'b0;
      csr_save_cause_o       = 1'b0;
      csr_mtval_o            = 32'd0;
      flush_id_o             = 1'b0;
      perf_jump_o            = 1'b0;
      perf_tbranch_o         = 1'b0;
    end comb
    seq
      illegal_insn_q          <= illegal_insn_d;
      exc_req_q               <= exc_req_d;
      load_err_q              <= load_err_i or load_err_q;
      store_err_q             <= store_err_i or store_err_q;
      debug_mode_q            <= debug_mode_q;
      nmi_mode_q              <= nmi_mode_q;
      enter_debug_mode_prio_q <= enter_debug_mode_prio_d;
      do_single_step_q        <= do_single_step_d;
    end seq
  end default

  // ── State: RESET (Spec §"Requirement 1") ─────────────────────────
  state StReset
    comb
      instr_req_o = 1'b0;
      pc_mux_o    = 3'd0;       // PC_BOOT
      pc_set_o    = 1'b1;
    end comb
    -> StBootSet;
  end state StReset

  // ── State: BOOT_SET (Spec §"Requirement 1") ──────────────────────
  state StBootSet
    comb
      instr_req_o = 1'b1;
      pc_mux_o    = 3'd0;       // PC_BOOT
      pc_set_o    = 1'b1;
    end comb
    -> StFirstFetch;
  end state StBootSet

  // ── State: FIRST_FETCH (Spec §"Requirement 1") ───────────────────
  state StFirstFetch
    comb
      instr_req_o = 1'b1;
      // halt_if is set when IRQ/debug pending; otherwise IF unhalted.
      id_in_ready_o = (not stall_w)
                      and (not (handle_irq or enter_debug_mode));
    end comb
    -> StIrqTaken when handle_irq and (not enter_debug_mode);
    -> StDbgTakenIf when enter_debug_mode;
    -> StDecode when (not handle_irq) and (not enter_debug_mode) and (not stall_w);
  end state StFirstFetch

  // ── State: DECODE (Spec §"Requirement 2", "Requirement 12") ──────
  state StDecode
    comb
      instr_req_o         = 1'b1;
      controller_run_o    = 1'b1;
      pc_mux_o            = 3'd1;      // PC_JUMP

      // Branch / jump pulse.
      pc_set_o            = branch_set_i or jump_set_i;
      perf_tbranch_o      = branch_set_i;
      perf_jump_o         = jump_set_i;

      // ID handshake. retain_id (= special_req) holds the instruction.
      // Mirrors upstream lines 864/871: id_in_ready_o = ~stall & ~halt_if & ~retain_id;
      // instr_valid_clear_o = ~(stall | retain_id) | flush_id (= 0 in DECODE).
      // The halt_if factor is critical for IRQ entry while ID drains.
      id_in_ready_o       = (not stall_w) and (not halt_if_decode) and (not special_req);
      instr_valid_clear_o = (not stall_w) and (not special_req);
    end comb
    -> StFlush when take_flush_in_decode;
    -> StDbgTakenIf when (not take_flush_in_decode) and take_dbg_in_decode;
    -> StIrqTaken when (not take_flush_in_decode) and (not take_dbg_in_decode) and take_irq_in_decode;
  end state StDecode

  // ── State: IRQ_TAKEN (Spec §"Requirement 3") ─────────────────────
  state StIrqTaken
    comb
      pc_mux_o     = 3'd2;       // PC_EXC
      exc_pc_mux_o = 2'd1;       // EXC_PC_IRQ

      pc_set_o         = handle_irq;
      csr_save_if_o    = handle_irq;
      csr_save_cause_o = handle_irq;

      // Priority ladder for exc_cause_o (Spec Requirement 3 ordering):
      // 1. NMI (under MemECC=0, only external)
      // 2. Fast IRQ (lowest-set wins, encoded by mfip_id)
      // 3. External
      // 4. Software
      // 5. Timer
      if irq_nm and (not nmi_mode_q)
        exc_cause_o = ExcCause {
          irq_int: 1'b0,
          irq_ext: 1'b1,
          lower_cause: 5'd31         // ExcCauseIrqNm
        };
      elsif irqs_i.irq_fast != 15'd0
        exc_cause_o = ExcCause {
          irq_int: 1'b0,
          irq_ext: 1'b1,
          lower_cause: ({1'b1, mfip_id}).resize<5>()
        };
      elsif irqs_i.irq_external
        exc_cause_o = ExcCause {
          irq_int: 1'b0,
          irq_ext: 1'b1,
          lower_cause: 5'd11         // ExcCauseIrqExternalM
        };
      elsif irqs_i.irq_software
        exc_cause_o = ExcCause {
          irq_int: 1'b0,
          irq_ext: 1'b1,
          lower_cause: 5'd3          // ExcCauseIrqSoftwareM
        };
      else
        exc_cause_o = ExcCause {
          irq_int: 1'b0,
          irq_ext: 1'b1,
          lower_cause: 5'd7          // ExcCauseIrqTimerM
        };
      end if
    end comb
    seq
      // NMI mode latch — set when IRQ_TAKEN handles a NMI.
      if handle_irq and irq_nm and (not nmi_mode_q)
        nmi_mode_q <= 1'b1;
      end if
    end seq
    -> StDecode;
  end state StIrqTaken

  // ── State: DBG_TAKEN_IF (Spec §"Requirement 4") ──────────────────
  state StDbgTakenIf
    comb
      pc_mux_o              = 3'd2;     // PC_EXC
      exc_pc_mux_o          = 2'd2;     // EXC_PC_DBD
      pc_set_o              = 1'b1;
      flush_id_o            = 1'b1;
      csr_save_if_o         = 1'b1;
      debug_csr_save_o      = 1'b1;
      csr_save_cause_o      = 1'b1;
      debug_mode_entering_o = 1'b1;
    end comb
    seq
      debug_mode_q  <= 1'b1;
      debug_cause_q <= 3'd3;            // DBG_CAUSE_HALTREQ (default)
    end seq
    -> StDecode;
  end state StDbgTakenIf

  // ── State: DBG_TAKEN_ID (Spec §"Requirement 4") ──────────────────
  state StDbgTakenId
    comb
      pc_mux_o              = 3'd2;     // PC_EXC
      exc_pc_mux_o          = 2'd2;     // EXC_PC_DBD
      pc_set_o              = 1'b1;
      flush_id_o            = 1'b1;
      debug_mode_entering_o = 1'b1;

      if ebreak_into_debug and (not debug_mode_q)
        csr_save_cause_o = 1'b1;
        csr_save_id_o    = 1'b1;
        debug_csr_save_o = 1'b1;
      end if
    end comb
    seq
      debug_mode_q  <= 1'b1;
      debug_cause_q <= 3'd1;            // DBG_CAUSE_EBREAK
    end seq
    -> StDecode;
  end state StDbgTakenId

  // ── State: FLUSH (Spec §"Requirement 5", "Requirement 7") ────────
  state StFlush
    comb
      flush_id_o          = 1'b1;
      // Upstream (line 871): instr_valid_clear_o = ~(stall|retain_id) | flush_id.
      // FLUSH always asserts flush_id, so the IF-side instruction must be
      // killed even though stall / retain_id are not driven here. Without
      // this the prefetch buffer keeps re-feeding the same PC after a
      // csr_pipe_flush (e.g. csrrw mtvec) and the program live-locks.
      instr_valid_clear_o = 1'b1;

      if exc_req_q or store_err_q or load_err_q
        // Exception path — set exception PC, save cause.
        pc_set_o         = 1'b1;
        pc_mux_o         = 3'd2;        // PC_EXC
        exc_pc_mux_o     = debug_mode_q ? 2'd3 : 2'd0;  // EXC_PC_DBG_EXC : EXC_PC_EXC
        csr_save_cause_o = 1'b1;
        // csr_save_id_o = 0 under WritebackStage=0 (g_no_writeback_mepc_save).

        // Priority ladder for exc_cause_o + csr_mtval_o (Spec
        // Requirement 7 ordering, mirrors upstream FLUSH `unique case`
        // under WritebackStage=0 — see ibex_controller.sv:756-797).
        // Without this, every synchronous exception (ecall, illegal,
        // instr-fetch-err, ebrk, load/store err) reaches cs_registers
        // with the StDecode-default `lower_cause: 5'd0`, mapping every
        // sync trap to ExcCauseInsnAddrMisa = 0. The 5 existing ISR
        // programs all test interrupts (StIrqTaken's separate ladder),
        // so this gap was undetected until ecall_isr added explicit
        // sync-exception coverage.
        if instr_fetch_err
          exc_cause_o = ExcCause {
            irq_int: 1'b0, irq_ext: 1'b0,
            lower_cause: 5'd1            // ExcCauseInstrAccessFault
          };
          csr_mtval_o = instr_fetch_err_plus2_i ? (pc_id_i +% 32'd2) : pc_id_i;
        elsif illegal_insn_q
          exc_cause_o = ExcCause {
            irq_int: 1'b0, irq_ext: 1'b0,
            lower_cause: 5'd2            // ExcCauseIllegalInsn
          };
          csr_mtval_o = instr_is_compressed_i ? {16'd0, instr_compressed_i} : instr_i;
        elsif ecall_insn
          exc_cause_o = (priv_mode_i == 2'd3)
            ? ExcCause { irq_int: 1'b0, irq_ext: 1'b0, lower_cause: 5'd11 }   // ExcCauseEcallMMode
            : ExcCause { irq_int: 1'b0, irq_ext: 1'b0, lower_cause: 5'd8 };   // ExcCauseEcallUMode
        elsif ebrk_insn
          if debug_mode_q or ebreak_into_debug
            // EBREAK enters debug — route handled by transition to
            // StDbgTakenId. Suppress exception bookkeeping per
            // upstream (pc_set/csr_save_cause cleared).
            pc_set_o         = 1'b0;
            csr_save_cause_o = 1'b0;
          else
            exc_cause_o = ExcCause {
              irq_int: 1'b0, irq_ext: 1'b0,
              lower_cause: 5'd3          // ExcCauseBreakpoint
            };
          end if
        elsif store_err_q
          exc_cause_o = ExcCause {
            irq_int: 1'b0, irq_ext: 1'b0,
            lower_cause: 5'd7            // ExcCauseStoreAccessFault
          };
          csr_mtval_o = lsu_addr_last_i;
        elsif load_err_q
          exc_cause_o = ExcCause {
            irq_int: 1'b0, irq_ext: 1'b0,
            lower_cause: 5'd5            // ExcCauseLoadAccessFault
          };
          csr_mtval_o = lsu_addr_last_i;
        end if
      elsif mret_insn
        pc_set_o              = 1'b1;
        pc_mux_o              = 3'd3;   // PC_ERET
        csr_restore_mret_id_o = 1'b1;
      elsif dret_insn
        pc_set_o              = 1'b1;
        pc_mux_o              = 3'd4;   // PC_DRET
        csr_restore_dret_id_o = 1'b1;
      end if
    end comb
    seq
      // Mode-flop updates per Spec Requirement 10.
      if dret_insn
        debug_mode_q <= 1'b0;
      end if
      if mret_insn and nmi_mode_q
        nmi_mode_q <= 1'b0;
      end if
      // Exception flop clears as we leave FLUSH (handled by default block
      // because illegal_insn_d / exc_req_d gate on `~in_flush`; but we're
      // always in this state body, so override to clear).
      illegal_insn_q <= 1'b0;
      exc_req_q      <= 1'b0;
      load_err_q     <= 1'b0;
      store_err_q    <= 1'b0;
    end seq
    -> StWaitSleep when wfi_insn;
    -> StDbgTakenIf when enter_debug_mode_prio_q and (not (ebrk_insn and ebreak_into_debug));
    -> StDbgTakenId when ebrk_insn and (debug_mode_q or ebreak_into_debug);
    -> StDecode when (not wfi_insn) and (not enter_debug_mode_prio_q) and (not (ebrk_insn and (debug_mode_q or ebreak_into_debug)));
  end state StFlush

  // ── State: WAIT_SLEEP (Spec §"Requirement 6") ────────────────────
  state StWaitSleep
    comb
      ctrl_busy_o = 1'b0;
      instr_req_o = 1'b0;
      flush_id_o  = 1'b1;
    end comb
    -> StSleep;
  end state StWaitSleep

  // ── State: SLEEP (Spec §"Requirement 6") ─────────────────────────
  state StSleep
    comb
      ctrl_busy_o = 1'b0;
      instr_req_o = 1'b0;
      flush_id_o  = 1'b1;
    end comb
    -> StFirstFetch when irq_nm or irq_pending_i or debug_req_i or debug_mode_q or debug_single_step_i;
  end state StSleep

end fsm ibex_controller
