/// IbexIcacheOutputStage — ARCH-native elastic output resolver.
///
/// This block owns only the IF-facing stream position (`addr_out_q`), a
/// one-entry hold register for backpressure, and the misaligned-32 skid
/// halfword. It does not carry a registered "valid pipeline"; `valid_o`
/// is combinational from either the held entry or the currently available
/// IC1/FB candidate that covers `addr_out_q`.

module IbexIcacheOutputStage
  port clk_i:  in Clock<SysDomain>;
  port rst_ni: in Reset<Async, Low>;

  port branch_i: in Bool;
  port addr_i:   in UInt<32>;
  port ready_i:  in Bool;

  // IC1 hit candidate. This is a behavior-level hit/data candidate,
  // not a structural copy of any upstream path.
  port lookup_addr_ic1_q:  in UInt<32>;
  port lookup_valid_ic1_q: in Bool;
  port any_hit_ic1:        in Bool;
  port hit_data_ic1:       in UInt<64>;

  // Live FB candidates. Parent overlays same-cycle bus rvalid data into
  // fb*_line_live and fb*_beats_live before driving these ports.
  port fb0_wants_out:  in Bool;
  port fb1_wants_out:  in Bool;
  port fb2_wants_out:  in Bool;
  port fb3_wants_out:  in Bool;
  port fb0_addr:       in UInt<32>;
  port fb1_addr:       in UInt<32>;
  port fb2_addr:       in UInt<32>;
  port fb3_addr:       in UInt<32>;
  port fb0_line:       in UInt<64>;
  port fb1_line:       in UInt<64>;
  port fb2_line:       in UInt<64>;
  port fb3_line:       in UInt<64>;
  port fb0_err_beat0:  in Bool;
  port fb1_err_beat0:  in Bool;
  port fb2_err_beat0:  in Bool;
  port fb3_err_beat0:  in Bool;
  port fb0_err_beat1:  in Bool;
  port fb1_err_beat1:  in Bool;
  port fb2_err_beat1:  in Bool;
  port fb3_err_beat1:  in Bool;
  port fb0_beats_live: in UInt<2>;
  port fb1_beats_live: in UInt<2>;
  port fb2_beats_live: in UInt<2>;
  port fb3_beats_live: in UInt<2>;
  port fb0_age:        in UInt<2>;
  port fb1_age:        in UInt<2>;
  port fb2_age:        in UInt<2>;
  port fb3_age:        in UInt<2>;

  port valid_o:     out Bool;
  port rdata_o:     out UInt<32>;
  port addr_o:      out UInt<32>;
  port err_o:       out Bool;
  port err_plus2_o: out Bool;

  port fb0_out_done_pulse: out Bool;
  port fb1_out_done_pulse: out Bool;
  port fb2_out_done_pulse: out Bool;
  port fb3_out_done_pulse: out Bool;

  default seq on clk_i rising;

  reg addr_out_q: UInt<32> reset rst_ni => 0;

  reg hold_valid_q:     Bool reset rst_ni => false;
  reg hold_rdata_q:     UInt<32> guard hold_valid_q reset none;
  reg hold_err_q:       Bool guard hold_valid_q reset none;
  reg hold_err_plus2_q: Bool guard hold_valid_q reset none;
  reg hold_done_q:      Bool guard hold_valid_q reset none;
  reg hold_done_idx_q:  UInt<2> guard hold_valid_q reset none;

  reg skid_data_q:  UInt<16> guard skid_valid_q reset none;
  reg skid_valid_q: Bool reset rst_ni => false;
  reg skid_err_q:   Bool guard skid_valid_q reset none;

  // A cache hit is only visible at the IC1 lookup output for one cycle,
  // but the IF stream may need both 32-bit words from that 64-bit line.
  // Keep the most recent hit line as an output-source candidate until
  // addr_out_q advances beyond it or a branch redirects the stream.
  reg ic1_hold_valid_q: Bool reset rst_ni => false;
  reg ic1_hold_addr_q:  UInt<29> guard ic1_hold_valid_q reset none;
  reg ic1_hold_line_q:  UInt<64> guard ic1_hold_valid_q reset none;

  let out_line_addr: UInt<29> = addr_out_q[31:3];
  let out_beat1: Bool = addr_out_q[2];
  let out_half1: Bool = addr_out_q[1];
  let skid_complete_instr: Bool =
    skid_valid_q and ((skid_data_q[1:0] != 2'd3) or skid_err_q);
  let skid_needs_next_line: Bool = skid_valid_q and (not skid_complete_instr);
  let skid_next_addr: UInt<32> = addr_out_q +% 32'd4;
  let source_line_addr: UInt<29> =
    skid_needs_next_line ? skid_next_addr[31:3] : out_line_addr;
  let source_beat1: Bool = skid_needs_next_line ? false : out_beat1;

  let ic1_covers: Bool =
    lookup_valid_ic1_q and any_hit_ic1
    and (lookup_addr_ic1_q[31:3] == source_line_addr);
  let ic1_hold_covers: Bool =
    ic1_hold_valid_q and (ic1_hold_addr_q == source_line_addr);
  let ic1_any_covers: Bool = ic1_covers or ic1_hold_covers;

  let fb0_beat_ready: Bool =
    source_beat1 ? (fb0_beats_live == 2'd2) : (fb0_beats_live != 2'd0);
  let fb1_beat_ready: Bool =
    source_beat1 ? (fb1_beats_live == 2'd2) : (fb1_beats_live != 2'd0);
  let fb2_beat_ready: Bool =
    source_beat1 ? (fb2_beats_live == 2'd2) : (fb2_beats_live != 2'd0);
  let fb3_beat_ready: Bool =
    source_beat1 ? (fb3_beats_live == 2'd2) : (fb3_beats_live != 2'd0);

  let fb0_covers: Bool =
    fb0_wants_out and (fb0_addr[31:3] == source_line_addr) and fb0_beat_ready;
  let fb1_covers: Bool =
    fb1_wants_out and (fb1_addr[31:3] == source_line_addr) and fb1_beat_ready;
  let fb2_covers: Bool =
    fb2_wants_out and (fb2_addr[31:3] == source_line_addr) and fb2_beat_ready;
  let fb3_covers: Bool =
    fb3_wants_out and (fb3_addr[31:3] == source_line_addr) and fb3_beat_ready;

  let fb0_cost: UInt<3> = fb0_covers ? {1'd0, fb0_age} : 3'd4;
  let fb1_cost: UInt<3> = fb1_covers ? {1'd0, fb1_age} : 3'd4;
  let fb2_cost: UInt<3> = fb2_covers ? {1'd0, fb2_age} : 3'd4;
  let fb3_cost: UInt<3> = fb3_covers ? {1'd0, fb3_age} : 3'd4;
  let fb_min01_cost: UInt<3> = fb0_cost <= fb1_cost ? fb0_cost : fb1_cost;
  let fb_min01_idx:  UInt<2> = fb0_cost <= fb1_cost ? 2'd0 : 2'd1;
  let fb_min23_cost: UInt<3> = fb2_cost <= fb3_cost ? fb2_cost : fb3_cost;
  let fb_min23_idx:  UInt<2> = fb2_cost <= fb3_cost ? 2'd2 : 2'd3;
  let fb_sel_idx: UInt<2> =
    fb_min01_cost <= fb_min23_cost ? fb_min01_idx : fb_min23_idx;
  let fb_any: Bool = fb0_covers or fb1_covers or fb2_covers or fb3_covers;

  let fb_sel_line: UInt<64> =
    (fb_sel_idx == 2'd0) ? fb0_line :
    ((fb_sel_idx == 2'd1) ? fb1_line :
    ((fb_sel_idx == 2'd2) ? fb2_line : fb3_line));
  let fb_sel_addr: UInt<32> =
    (fb_sel_idx == 2'd0) ? fb0_addr :
    ((fb_sel_idx == 2'd1) ? fb1_addr :
    ((fb_sel_idx == 2'd2) ? fb2_addr : fb3_addr));
  let fb_sel_beats: UInt<2> =
    (fb_sel_idx == 2'd0) ? fb0_beats_live :
    ((fb_sel_idx == 2'd1) ? fb1_beats_live :
    ((fb_sel_idx == 2'd2) ? fb2_beats_live : fb3_beats_live));
  let fb_sel_err0: Bool =
    (fb_sel_idx == 2'd0) ? fb0_err_beat0 :
    ((fb_sel_idx == 2'd1) ? fb1_err_beat0 :
    ((fb_sel_idx == 2'd2) ? fb2_err_beat0 : fb3_err_beat0));
  let fb_sel_err1: Bool =
    (fb_sel_idx == 2'd0) ? fb0_err_beat1 :
    ((fb_sel_idx == 2'd1) ? fb1_err_beat1 :
    ((fb_sel_idx == 2'd2) ? fb2_err_beat1 : fb3_err_beat1));

  // IC1 has data priority, but a same-line FB remains associated for
  // lifecycle completion when the accepted output consumes the FB's
  // last beat.
  let raw_valid: Bool = ic1_any_covers or fb_any;
  let raw_line: UInt<64> =
    ic1_covers ? hit_data_ic1 :
    (ic1_hold_covers ? ic1_hold_line_q : fb_sel_line);
  let raw_is_fb: Bool = fb_any;
  let raw_fb_idx: UInt<2> = fb_sel_idx;
  let raw_fb_addr: UInt<32> = fb_sel_addr;
  let raw_beats: UInt<2> = fb_any ? fb_sel_beats : 2'd2;
  let raw_err0: Bool = fb_any ? fb_sel_err0 : false;
  let raw_err1: Bool = fb_any ? fb_sel_err1 : false;

  let raw_word: UInt<32> = source_beat1 ? raw_line[63:32] : raw_line[31:0];
  let next_word: UInt<32> = source_beat1 ? 32'd0 : raw_line[63:32];
  let raw_curr_err: Bool = source_beat1 ? raw_err1 : raw_err0;
  let raw_next_err: Bool = source_beat1 ? false : raw_err1;
  let raw_has_next_word: Bool =
    raw_valid and (not source_beat1) and (raw_beats == 2'd2);

  let lower_half: UInt<16> = out_half1 ? raw_word[31:16] : raw_word[15:0];
  let lower_is_compressed_or_err: Bool =
    (lower_half[1:0] != 2'd3) or raw_curr_err;

  let normal_valid: Bool =
    raw_valid and (
      (not out_half1)
      or lower_is_compressed_or_err
      or raw_has_next_word);

  let normal_crosses_next: Bool =
    out_half1 and (not lower_is_compressed_or_err);
  let normal_rdata: UInt<32> =
    (not out_half1) ? raw_word :
    (lower_is_compressed_or_err ? ({16'd0, raw_word[31:16]}).resize<32>()
                                : {next_word[15:0], raw_word[31:16]});
  let normal_err: Bool =
    normal_crosses_next ? (raw_curr_err or raw_next_err) : raw_curr_err;
  let normal_err_plus2: Bool =
    (normal_crosses_next and (not raw_curr_err) and raw_next_err)
    or (raw_is_fb and out_beat1 and raw_fb_addr[1] and raw_err1);

  let skid_bridge_valid: Bool =
    skid_needs_next_line and raw_valid;
  let skid_bridge_err: Bool = skid_err_q or raw_next_err;
  let skid_bridge_err_plus2: Bool = (not skid_err_q) and raw_next_err;

  let need_skid_load: Bool =
    (not hold_valid_q)
    and raw_valid
    and out_half1
    and (not lower_is_compressed_or_err)
    and (not raw_has_next_word)
    and (not skid_valid_q);

  let nonheld_valid: Bool =
    skid_complete_instr or skid_bridge_valid or normal_valid;
  let nonheld_rdata: UInt<32> =
    skid_complete_instr ? ({16'd0, skid_data_q}).resize<32>() :
    (skid_bridge_valid ? {raw_word[15:0], skid_data_q} : normal_rdata);
  let nonheld_err: Bool =
    skid_complete_instr ? skid_err_q :
    (skid_bridge_valid ? skid_bridge_err : normal_err);
  let nonheld_err_plus2: Bool =
    skid_complete_instr ? false :
    (skid_bridge_valid ? skid_bridge_err_plus2 : normal_err_plus2);

  let source_done_on_accept: Bool =
    raw_is_fb and (
      out_beat1
      or (normal_valid and normal_crosses_next and raw_has_next_word));
  let skid_load_done: Bool =
    need_skid_load and raw_is_fb and out_beat1;
  let fb0_behind_done: Bool =
    fb0_wants_out and (fb0_addr[31:3] < out_line_addr);
  let fb1_behind_done: Bool =
    fb1_wants_out and (fb1_addr[31:3] < out_line_addr);
  let fb2_behind_done: Bool =
    fb2_wants_out and (fb2_addr[31:3] < out_line_addr);
  let fb3_behind_done: Bool =
    fb3_wants_out and (fb3_addr[31:3] < out_line_addr);

  let out_valid_comb: Bool = hold_valid_q or nonheld_valid;
  let out_rdata_comb: UInt<32> = hold_valid_q ? hold_rdata_q : nonheld_rdata;
  let out_err_comb: Bool = hold_valid_q ? hold_err_q : nonheld_err;
  let out_err_plus2_comb: Bool =
    hold_valid_q ? hold_err_plus2_q : nonheld_err_plus2;
  let accept_output: Bool = out_valid_comb and ready_i;

  let accept_done: Bool =
    (hold_valid_q and hold_done_q)
    or ((not hold_valid_q) and nonheld_valid and source_done_on_accept);
  let accept_done_idx: UInt<2> =
    hold_valid_q ? hold_done_idx_q : raw_fb_idx;
  let accepted_next_addr: UInt<32> =
    ((out_rdata_comb[1:0] != 2'd3) or out_err_comb)
      ? (addr_out_q +% 32'd2)
      : (addr_out_q +% 32'd4);

  comb
    valid_o     = out_valid_comb;
    rdata_o     = out_rdata_comb;
    addr_o      = addr_out_q;
    err_o       = out_err_comb;
    err_plus2_o = out_err_plus2_comb;

    fb0_out_done_pulse =
      (accept_output and accept_done and (accept_done_idx == 2'd0))
      or (skid_load_done and (raw_fb_idx == 2'd0))
      or fb0_behind_done;
    fb1_out_done_pulse =
      (accept_output and accept_done and (accept_done_idx == 2'd1))
      or (skid_load_done and (raw_fb_idx == 2'd1))
      or fb1_behind_done;
    fb2_out_done_pulse =
      (accept_output and accept_done and (accept_done_idx == 2'd2))
      or (skid_load_done and (raw_fb_idx == 2'd2))
      or fb2_behind_done;
    fb3_out_done_pulse =
      (accept_output and accept_done and (accept_done_idx == 2'd3))
      or (skid_load_done and (raw_fb_idx == 2'd3))
      or fb3_behind_done;
  end comb

  seq on clk_i rising
    if branch_i
      addr_out_q <= addr_i;
    elsif accept_output
      addr_out_q <= accepted_next_addr;
    end if
  end seq

  seq on clk_i rising
    if branch_i
      ic1_hold_valid_q <= false;
    elsif ic1_covers
      ic1_hold_valid_q <= true;
      ic1_hold_addr_q  <= lookup_addr_ic1_q[31:3];
      ic1_hold_line_q  <= hit_data_ic1;
    elsif accept_output and ic1_hold_valid_q
      if accepted_next_addr[31:3] != ic1_hold_addr_q
        ic1_hold_valid_q <= false;
      end if
    end if
  end seq

  seq on clk_i rising
    if branch_i
      hold_valid_q <= false;
    elsif hold_valid_q
      if ready_i
        hold_valid_q <= false;
      end if
    elsif nonheld_valid and (not ready_i)
      hold_valid_q     <= true;
      hold_rdata_q     <= nonheld_rdata;
      hold_err_q       <= nonheld_err;
      hold_err_plus2_q <= nonheld_err_plus2;
      hold_done_q      <= source_done_on_accept;
      hold_done_idx_q  <= raw_fb_idx;
    end if
  end seq

  seq on clk_i rising
    if branch_i
      skid_valid_q <= false;
    elsif nonheld_valid and (skid_complete_instr or skid_bridge_valid)
      // The full instruction has been materialized either directly on
      // the bus or in the hold register; the skid halfword is no longer
      // needed even if ready_i is low this cycle.
      skid_valid_q <= false;
    elsif need_skid_load
      skid_data_q  <= raw_word[31:16];
      skid_err_q   <= raw_curr_err;
      skid_valid_q <= true;
    end if
  end seq

end module IbexIcacheOutputStage
