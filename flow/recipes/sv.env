# SV (upstream Ibex) lane timing-closure recipe (see flow/recipes/recipe.sh).
# Measured 2026-09-24, sky130hd, OpenROAD regression flow, single P&R run per
# setting (routed WNS setup / Fmax = 1/(10 ns - WNS)):
#   plain flow                                   -9.660 ns   50.9 MHz
#   TIMING_DRIVEN_GPL=1                          -9.597 ns   51.0 MHz  <- this recipe
#   SYNTH_NOABC=1 + TIMING_DRIVEN_GPL=1          -11.178 ns  47.2 MHz  (worse)
#   KEEP_ALU_HIERARCHY (since removed)           -13.062 ns  (worse)
SYNTH_NOABC=0
TIMING_DRIVEN_GPL=1
