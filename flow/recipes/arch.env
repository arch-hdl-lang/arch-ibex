# Arch lane timing-closure recipe (see flow/recipes/recipe.sh).
# Measured 2026-09-25, sky130hd, OpenROAD regression flow, arch-ibex d14751d,
# single P&R run per setting (routed WNS setup / Fmax = 1/(10 ns - WNS)):
#   plain flow                                          -11.241 ns  47.1 MHz
#   TIMING_DRIVEN_GPL=1                                 -10.605 ns  48.5 MHz
#   SYNTH_NOABC=1 + TIMING_DRIVEN_GPL=1                 -9.404 ns   51.5 MHz
#   ... + SYNTH_ADDR_ADDER=ks (ALU adder only)          -8.852 ns   53.0 MHz
#   ... + SYNTH_ADDER=ks (all 68 adders)                -7.935 ns   55.8 MHz  <- this recipe
# The all-adder gain exceeds the ALU adder's although no other adder is on the
# worst (data_req_o) path: ABC restructures the flattened design as a whole,
# so re-check this knob with flow/openroad/estimate.sh after RTL changes
# (it predicted -8.84 and -7.72 for the last two rows). Area +0.4%.
SYNTH_NOABC=1
TIMING_DRIVEN_GPL=1
SYNTH_ADDER=ks

# ECP5 (nextpnr-ecp5 --85k CABGA381 speed 6, 50 MHz target), measured
# 2026-09-26 on arch-ibex 1a4386a, fmax mean over seeds [min-max]:
#   placer timing weight 10 (nextpnr default)  30.02 [28.07-31.73]  n=5
#                        20                    31.22 [30.71-31.66]  n=5
#                        40                    31.50 [30.73-32.70]  n=10  <- this recipe
#                        60                    31.51 [30.35-32.44]  n=10
#                        80                    31.60 [30.54-32.16]  n=10
#                        120 / 160             31.00 / 31.09        n=5
# 40-80 is a plateau within seed noise (sd ~0.5); 40 sits mid-plateau, away
# from the drop above 80. Synthesis knobs (-abc2, -dff, -nowidelut, -noabc9,
# -noccu2) and router2 / the SA placer were all slower (2026-09-25 sweep).
ECP5_PLACER_TIMINGWEIGHT=40
