# Fill-buffer selection uniqueness (see prop.v). Inputs: make.py.
[tasks]
bmc    bmc
prove  prove
cover  cov

[options]
aigsmt z3
bmc: mode bmc
bmc: depth 40
prove: mode prove
cov: mode cover
cov: depth 40

[engines]
bmc: abc bmc3
prove: abc pdr
cov: smtbmc boolector

[script]
cov: read_verilog -formal -DCOVERS icache_fbsel.v
~cov: read_verilog -formal icache_fbsel.v
read_verilog -formal live_top.v
prep -top live_top
async2sync
flatten
memory -nomap
memory_map
opt -full
techmap
opt -fast
setundef -undriven -anyseq
setundef -anyseq

[files]
icache_fbsel.v
live_top.v
